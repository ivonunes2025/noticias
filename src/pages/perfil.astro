---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCategorias, normalize } from "../utils/strapi";
import NewsletterForm from "../components/NewsletterForm.astro";
import "../styles/perfil.css";

const user = Astro.cookies.get('user_name')?.value;
if (!user) return Astro.redirect('/login');

const rawCategorias = await getCategorias();
const categorias = normalize(rawCategorias);
---

<Layout titulo="O Meu Perfil">
  <Navbar isHome={false} />

  <div class="perfil-container">
    <header class="perfil-header">
      <div class="profile-photo-wrapper">
        <div class="perfil-icon-large" id="profile-preview">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <label for="profile-upload" class="photo-edit-btn" title="Alterar foto de perfil">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>
          </svg>
        </label>
        <input type="file" id="profile-upload" accept="image/*" hidden />
      </div>
      <h1>O Meu Perfil</h1>
      <p>Personalize a sua experiência e a sua identidade no site.</p>
    </header>

    <div class="perfil-content">
      <section class="categorias-selection" id="preferencias">
        <h2>Categorias Favoritas</h2>
        <p class="instruction">Selecione as categorias para as quais deseja receber mais destaque:</p>
        
        <div class="categorias-grid">
          {categorias.map((cat: any) => {
            const slug = cat.slug ?? cat.id;
            const nome = cat.nome ?? cat.name ?? slug;
            return (
              <label class="categoria-chip">
                <input type="checkbox" name="categorias" value={slug} />
                <span class="chip-text">{nome}</span>
              </label>
            );
          })}
        </div>
        
        <div class="save-actions">
          <button id="save-prefs" class="save-button">Guardar Preferências</button>
          <span id="status-msg" class="status-msg"></span>
        </div>
      </section>

      <section class="tema-selection" id="tema">
        <h2>Tema Visual</h2>
        <p class="instruction">Escolha a aparência que mais lhe agrada para navegar no site:</p>
        
        <div class="temas-grid">
          <button class="tema-card" data-theme="default">
            <div class="tema-preview theme-default"></div>
            <span>Dourado (Padrão)</span>
          </button>
          <button class="tema-card" data-theme="dark">
            <div class="tema-preview theme-dark"></div>
            <span>Minimalista (P&B)</span>
          </button>
        </div>
      </section>

      <section class="perfil-section" id="guardados">
        <SectionHeader title="Ler Depois" />
        <p class="instruction">Notícias que guardou para ler com mais calma.</p>
        
        <div class="carrossel">
          <button type="button" class="carrossel-arrow carrossel-prev" aria-label="Anterior">‹</button>
          <button type="button" class="carrossel-arrow carrossel-next" aria-label="Próximo">›</button>
          <div id="saved-news-container" class="carrossel-track">
            <!-- Preenchido via JavaScript -->
          </div>
        </div>
      </section>

      <section class="perfil-section" id="newsletter">
        <h2>Newsletter</h2>
        <p class="instruction">Escolha se deseja receber as nossas notícias por email.</p>
        <NewsletterForm variant="card" titulo="Receba as notícias por email" />
      </section>

    </div>
  </div>
</Layout>

<script>
  function getCookie(name: string) {
    const nameEQ = name + "=";
    const ca = document.cookie.split(";");
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i];
      while (c.charAt(0) === " ") c = c.substring(1, c.length);
      if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
    }
    return null;
  }

  const photoInput = document.getElementById('profile-upload') as HTMLInputElement;
  const photoPreview = document.getElementById('profile-preview');
  const statusMsg = document.getElementById('status-msg');
  
  const currentUser = getCookie('user_name');
  const photoKey = currentUser ? `profile-photo-${currentUser}` : 'profile-photo-guest';

  const savedPhoto = localStorage.getItem(photoKey);
  if (savedPhoto && photoPreview) {
    photoPreview.innerHTML = `<img src="${savedPhoto}" alt="Foto de Perfil" />`;
  }

  photoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const base64 = event.target?.result as string;
        if (photoPreview) {
          photoPreview.innerHTML = `<img src="${base64}" alt="Foto de Perfil" />`;
          localStorage.setItem(photoKey, base64);
          if (statusMsg) {
            statusMsg.textContent = 'Foto atualizada!';
            statusMsg.classList.add('success');
            setTimeout(() => {
              statusMsg.textContent = '';
              statusMsg.classList.remove('success');
            }, 2000);
          }
        }
      };
      reader.readAsDataURL(file);
    }
  });

  const saveBtn = document.getElementById('save-prefs');
  const checkboxes = document.querySelectorAll('input[name="categorias"]') as NodeListOf<HTMLInputElement>;

  const userPrefs = localStorage.getItem(`prefs-${currentUser}`);
  if (userPrefs) {
    const savedCats = JSON.parse(userPrefs);
    checkboxes.forEach((cb) => {
      if (savedCats.includes(cb.value)) cb.checked = true;
    });
  }

  saveBtn?.addEventListener('click', () => {
    const selected = Array.from(checkboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.value);
    localStorage.setItem(`prefs-${currentUser}`, JSON.stringify(selected));
    if (statusMsg) {
      statusMsg.textContent = 'Preferências guardadas!';
      statusMsg.classList.add('success');
      setTimeout(() => {
        statusMsg.textContent = '';
        statusMsg.classList.remove('success');
      }, 2000);
    }
  });

  const themeCards = document.querySelectorAll('.tema-card');
  const currentTheme = localStorage.getItem('theme') || 'default';
  themeCards.forEach(card => {
    if (card.getAttribute('data-theme') === currentTheme) {
      card.classList.add('active');
    }
  });

  themeCards.forEach(card => {
    card.addEventListener('click', () => {
      const theme = card.getAttribute('data-theme');
      if (!theme) return;
      if (theme === 'default') {
        document.documentElement.removeAttribute('data-theme');
      } else {
        document.documentElement.setAttribute('data-theme', theme);
      }
      themeCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      localStorage.setItem('theme', theme);
    });
  });

  function updateSavedNews() {
    const container = document.getElementById('saved-news-container');
    if (!container) return;

    const saved = localStorage.getItem('ler-depois');
    const news = saved ? JSON.parse(saved) : [];

    if (news.length === 0) {
      container.innerHTML = `
        <div class="empty-saved">
          <div class="empty-saved-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <p>Ainda não guardou nenhuma notícia para ler depois.</p>
        </div>
      `;
      const carrossel = container.closest('.carrossel');
      if (carrossel) {
        const arrows = carrossel.querySelectorAll('.carrossel-arrow');
        arrows.forEach((a: any) => a.style.display = 'none');
      }
      return;
    }

    container.innerHTML = news.map((n: any) => `
      <div class="carrossel-slide">
        <div class="noticia-card" data-id="${n.id}">
          <div class="noticia-img-wrapper">
            <img src="${n.imagem}" alt="${n.titulo}" class="noticia-img" onclick="window.location.href='/noticias/${n.id}'" style="cursor: pointer;" />
            <button class="remove-saved-btn" data-id="${n.id}" title="Remover dos guardados">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <div class="noticia-corpo" onclick="window.location.href='/noticias/${n.id}'" style="cursor: pointer;">
            <span class="noticia-data">${n.data}</span>
            <h3 class="noticia-titulo">${n.titulo}</h3>
          </div>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.remove-saved-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = btn.getAttribute('data-id');
        if (!id) return;
        const modal = document.createElement('div');
        modal.className = 'confirm-modal-overlay';
        modal.innerHTML = `
          <div class="confirm-modal">
            <p>Deseja remover dos guardados?</p>
            <div class="confirm-modal-btns">
              <button class="confirm-btn yes">Sim</button>
              <button class="confirm-btn no">Não</button>
            </div>
          </div>
        `;
        document.body.appendChild(modal);
        modal.querySelector('.no')?.addEventListener('click', () => modal.remove());
        modal.querySelector('.yes')?.addEventListener('click', () => {
          let saved = JSON.parse(localStorage.getItem('ler-depois') || '[]');
          saved = saved.filter((n: any) => n.id !== id);
          localStorage.setItem('ler-depois', JSON.stringify(saved));
          window.dispatchEvent(new CustomEvent('bookmarks-updated'));
          updateSavedNews();
          modal.remove();
        });
      });
    });

    const carrossel = container.closest('.carrossel');
    if (carrossel && news.length > 0) {
      const prevBtn = carrossel.querySelector('.carrossel-arrow.carrossel-prev') as HTMLButtonElement;
      const nextBtn = carrossel.querySelector('.carrossel-arrow.carrossel-next') as HTMLButtonElement;
      const slides = carrossel.querySelectorAll('.carrossel-slide');
      if (prevBtn && nextBtn && slides.length > 0) {
        prevBtn.style.display = 'flex';
        nextBtn.style.display = 'flex';
        const slideWidth = (slides[0] as HTMLElement).offsetWidth + 24;
        prevBtn.onclick = () => container.scrollBy({ left: -slideWidth, behavior: 'smooth' });
        nextBtn.onclick = () => container.scrollBy({ left: slideWidth, behavior: 'smooth' });
        let isDown = false;
        let startX: number;
        let scrollLeft: number;
        container.onmousedown = (e: MouseEvent) => {
          isDown = true;
          container.classList.add('active');
          startX = e.pageX - container.offsetLeft;
          scrollLeft = container.scrollLeft;
        };
        container.onmouseleave = () => { isDown = false; container.classList.remove('active'); };
        container.onmouseup = () => { isDown = false; container.classList.remove('active'); };
        container.onmousemove = (e: MouseEvent) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - container.offsetLeft;
          const walk = (x - startX) * 2;
          container.scrollLeft = scrollLeft - walk;
        };
      }
    }
  }

  updateSavedNews();
  window.addEventListener('bookmarks-updated', updateSavedNews);
  document.addEventListener('astro:after-swap', () => { updateSavedNews(); });
</script>