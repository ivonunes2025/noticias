---
// Página de resultados de pesquisa
// - rota: /pesquisa?q=termo
// - origem: campo de pesquisa da Navbar (Enter)
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CardNoticia from "../components/CardNoticia.astro";
import Pagination from "../components/Pagination.astro";
import { fetchStrapi, normalize } from "../utils/strapi";
import "../styles/pesquisa.css";

const q = (Astro.url.searchParams.get("q") ?? "").trim();
const page = Number(Astro.url.searchParams.get("page") || 1);
const pageSize = 9;

let noticias: any[] = [];
let meta = { page: 1, pageSize: 9, pageCount: 1, total: 0 };

if (q) {
  try {
    const encoded = encodeURIComponent(q);

    const noticiasRes = await fetchStrapi(`noticias`, {
      'filters[$or][0][titulo][$containsi]': q,
      'filters[$or][1][conteudo][$containsi]': q,
      'populate': '*',
      'pagination[page]': page,
      'pagination[pageSize]': pageSize,
      'sort': 'publishedAt:desc'
    });

    noticias = normalize(noticiasRes);
    meta = noticiasRes?.meta?.pagination || meta;
  } catch (e) {
    console.error("Erro ao pesquisar no Strapi:", e);
  }
}

const temResultados = noticias.length > 0;
---

<Layout titulo={q ? `Resultados da pesquisa - "${q}"` : "Resultados da pesquisa"}>
  <Navbar isHome={false} />

  <section class="pesquisa">
    <a href="/" class="voltar">← Voltar</a>
    <h1>Resultados da pesquisa</h1>

    {
      q ? (
        <p class="pesquisa-query">
          Encontrámos {noticias.length} resultados para "{q}"
        </p>
      ) : (
        <p class="pesquisa-query">
          Introduza um termo de pesquisa na barra superior.
        </p>
      )
    }

    {q && !temResultados && <p class="sem-resultados">Não há resultados.</p>}

    {
      q && temResultados && (
        <div class="resultados-wrapper">
          <section class="bloco-resultados">
            <div class="noticias-grid">
              {noticias.map((n: any) => (
                <CardNoticia noticia={n} />
              ))}
            </div>
          </section>

          <Pagination 
            currentPage={meta.page} 
            totalPages={meta.pageCount} 
            baseUrl="/pesquisa"
          />
        </div>
      )
    }
  </section>
</Layout>
