---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CardNoticia from "../components/CardNoticia.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HomepageBanner from "../components/HomepageBanner.astro";
import { getImageUrl, checkAuth, fetchStrapi, normalize } from "../utils/strapi";
import { SITE_CONFIG } from "../utils/config";
import "../styles/home.css";

// Busca notícias e categorias em paralelo usando o novo utilitário dinâmico
const [rawNews, rawCategorias] = await Promise.all([
  fetchStrapi('noticias', { 
    'populate[capa][fields][0]': 'url', 
    'populate[categorias][fields][0]': 'slug', 
    'populate[categorias][fields][1]': 'nome', 
    'pagination[pageSize]': 48, 
    'sort': 'publishedAt:desc' 
  }).then(d => d || []),
  fetchStrapi('categorias', { 
    'pagination[pageSize]': 20, 
    'sort': 'nome:asc' 
  }).then(d => d || []),
]);

// Normaliza os dados para respeitar a Law of Demeter
const news = normalize(rawNews);
const categorias = normalize(rawCategorias);

// Estado de autenticação (Cookies) para filtrar notícias privadas
const cookies = Astro.cookies;
const isAuthenticated = checkAuth(cookies);

// Filtra notícias válidas (com slug)
const newsValid = news.filter((n: any) => Boolean(n.slug));

// 🌟 Secção "Em Destaque": apenas as que têm o campo 'destaque' como verdadeiro
const featuredNews = newsValid.filter((n: any) => n.destaque === true).slice(0, 6);

// Se não houver nenhuma marcada como destaque, mostramos as 3 mais recentes por defeito
const displayFeatured = featuredNews.length > 0 ? featuredNews : newsValid.slice(0, 3);

// Últimas 10 notícias para o ticker
const tickerNews = newsValid.slice(0, 10);

// Notícias por categoria (máx 6 por categoria)
const noticiasPorCategoria = categorias.map((cat: any) => {
  const catSlug = cat.slug ?? "";
  const catNome = cat.nome ?? cat.name ?? catSlug;

  const noticias = newsValid.filter((n: any) => {
    const cats = n.categorias || [];
    const items = Array.isArray(cats) ? cats : [cats];
    return items.some((c: any) => c.slug === catSlug);
  }).slice(0, 6);

  return { slug: catSlug, nome: catNome, noticias };
}).filter((c: any) => c.noticias.length > 0);

// ── Lógica SSR para "Para Si" ──
const prefsCookie = Astro.cookies.get('preferencias-categorias');

let favoriteNews: any[] = [];
let hasPrefs = false;

if (isAuthenticated && prefsCookie && prefsCookie.value) {
  try {
    const prefs = JSON.parse(prefsCookie.value);
    if (Array.isArray(prefs) && prefs.length > 0) {
      hasPrefs = true;
      favoriteNews = newsValid.filter((n: any) => {
        const cats = n.categorias || [];
        const catSlugs = (Array.isArray(cats) ? cats : [cats]).map((c: any) => c.slug ?? "");
        return catSlugs.some((cat: string) => prefs.includes(cat));
      }).slice(0, 10);
    }
  } catch (e) {
    hasPrefs = false;
  }
}

// Determinar a imagem LCP para pré-carregamento
const lcpImageUrl = hasPrefs && favoriteNews.length > 0 
  ? getImageUrl(favoriteNews[0].capa ?? favoriteNews[0].imagem)
  : (displayFeatured.length > 0 ? getImageUrl(displayFeatured[0].capa ?? displayFeatured[0].imagem) : null);
---

<Layout lcpImage={lcpImageUrl}>
  <Navbar isHome={true} />

  <HomepageBanner />

  {/* ── Ticker Personalizado: Para Si (SSR) ── */}
  {hasPrefs && favoriteNews.length > 0 && (
    <div id="para-si-ticker" class="ticker-bar ticker-bar--personal">
      <span class="ticker-label">{SITE_CONFIG.ui.home.paraSi}</span>
      <div class="ticker-track-wrapper">
        <div class="ticker-track">
          {[...favoriteNews, ...favoriteNews].map((n: any) => (
            <a href={`/noticias/${n.slug}`} class="ticker-item">
              <span class="ticker-dot">●</span>
              {n.titulo}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {/* ── Secção Personalizada: Para Si (SSR) ── */}
  {hasPrefs && favoriteNews.length > 0 && (
    <section id="para-si" class="personal-section">
      <SectionHeader title={SITE_CONFIG.ui.home.paraSi} />
      <div class="carrossel">
        <button type="button" class="carrossel-arrow carrossel-prev" aria-label="Anterior">‹</button>
        <button type="button" class="carrossel-arrow carrossel-next" aria-label="Próximo">›</button>
        <div class="carrossel-track">
          {favoriteNews.map((n: any, index: number) => (
            <div class="carrossel-slide">
              <CardNoticia noticia={n} isLCP={index === 0} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── Breaking News Ticker ── */}
  {tickerNews.length > 0 && (
    <div class="ticker-bar">
      <span class="ticker-label">{SITE_CONFIG.ui.home.ultimas}</span>
      <div class="ticker-track-wrapper">
        <div class="ticker-track">
          {[...tickerNews, ...tickerNews].map((n: any) => (
            <a href={`/noticias/${n.slug}`} class="ticker-item">
              <span class="ticker-dot">●</span>
              {n.titulo}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  {/* ── Em Destaque ── */}
  <section id="noticias">
    <SectionHeader title={SITE_CONFIG.ui.home.destaque} />
    {displayFeatured.length > 0 && (
      <div class="carrossel">
        <button type="button" class="carrossel-arrow carrossel-prev" aria-label="Notícia anterior">‹</button>
        <button type="button" class="carrossel-arrow carrossel-next" aria-label="Próxima notícia">›</button>
        <div class="carrossel-track">
          {displayFeatured.map((n: any, index: number) => (
            <div class="carrossel-slide">
              <CardNoticia noticia={n} isLCP={!hasPrefs && index === 0} />
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  {/* ── Últimas Notícias ── */}
  {newsValid.length > 0 && (
    <section id="ultimas" class="ultimas-section">
      <SectionHeader title={SITE_CONFIG.ui.home.ultimas} />
      <div class="ultimas-grid">
        {newsValid.slice(0, 6).map((n: any) => (
          <CardNoticia noticia={n} horizontal={true} />
        ))}
      </div>
      <div class="ver-mais-container">
        <a href="/noticias" class="btn-ver-mais">
          Ver Todas as Notícias
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </section>
  )}

  {/* ── Por Categoria ── */}
  {noticiasPorCategoria.map((cat: any) => (
    <section class="categoria-section">
      <SectionHeader title={cat.nome} href={`/categorias/${cat.slug}`} />
      <div class="carrossel carrossel-cat" data-cat={cat.slug}>
        <button type="button" class="carrossel-arrow carrossel-prev" aria-label="Anterior">‹</button>
        <button type="button" class="carrossel-arrow carrossel-next" aria-label="Próximo">›</button>
        <div class="carrossel-track">
          {cat.noticias.map((n: any) => (
            <div class="carrossel-slide">
              <CardNoticia noticia={n} />
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Navbar active link por secção ──
    const sections = document.querySelectorAll("section[id]");
    const links = document.querySelectorAll("nav a");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.remove("ativo");
              if (link.getAttribute("href") === `#${entry.target.id}`) {
                link.classList.add("ativo");
              }
            });
          }
        });
      },
      { threshold: 0.4 },
    );

    sections.forEach((s) => observer.observe(s));
  });
</script>