---
// Página Geral de Notícias com Paginação
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardNoticia from "../../components/CardNoticia.astro";
import Pagination from "../../components/Pagination.astro";
import { fetchStrapi, normalize } from "../../utils/strapi";
import "../../styles/noticias-list.css";

const page = Number(Astro.url.searchParams.get("page") || 1);
const pageSize = 12;

const noticiasRes = await fetchStrapi(`noticias`, {
  'populate[capa][fields][0]': 'url',
  'populate[categorias][fields][0]': 'slug',
  'populate[categorias][fields][1]': 'nome',
  'pagination[page]': page,
  'pagination[pageSize]': pageSize,
  'sort': 'publishedAt:desc'
});

const news = normalize(noticiasRes);
const meta = noticiasRes?.meta?.pagination || { page: 1, pageSize: 12, pageCount: 1, total: 0 };
---

<Layout titulo="Todas as Notícias">
  <Navbar isHome={false} />

  <section class="todas-noticias">
    <a href="/" class="voltar">← Voltar para o Início</a>
    <h1>Todas as Notícias</h1>
    <p class="section-desc">Explore todas as notícias e atualizações mais recentes.</p>

    {
      news.length > 0 ? (
        <>
          <div class="noticias-grid">
            {news.map((n: any) => (
              <CardNoticia noticia={n} />
            ))}
          </div>

          <Pagination 
            currentPage={meta.page} 
            totalPages={meta.pageCount} 
            baseUrl="/noticias"
          />
        </>
      ) : (
        <p class="sem-noticias">Não foram encontradas notícias.</p>
      )
    }
  </section>
</Layout>
