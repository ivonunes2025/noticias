---
// Página Geral de Notícias com Paginação
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardNoticia from "../../components/CardNoticia.astro";
import Pagination from "../../components/Pagination.astro";
import { fetchStrapi, normalize } from "../../utils/strapi";

const page = Number(Astro.url.searchParams.get("page") || 1);
const pageSize = 12;

const noticiasRes = await fetchStrapi(`noticias`, {
  'populate[capa][fields][0]': 'url',
  'populate[categorias][fields][0]': 'slug',
  'populate[categorias][fields][1]': 'nome',
  'pagination[page]': page,
  'pagination[pageSize]': pageSize,
  'sort': 'publishedAt:desc'
});

const news = normalize(noticiasRes);
const meta = noticiasRes?.meta?.pagination || { page: 1, pageSize: 12, pageCount: 1, total: 0 };
---

<Layout titulo="Todas as Notícias">
  <Navbar isHome={false} />

  <section class="todas-noticias">
    <a href="/" class="voltar">← Voltar para o Início</a>
    <h1>Todas as Notícias</h1>
    <p class="section-desc">Explore todas as notícias e atualizações mais recentes.</p>

    {
      news.length > 0 ? (
        <>
          <div class="noticias-grid">
            {news.map((n: any) => (
              <CardNoticia noticia={n} />
            ))}
          </div>

          <Pagination 
            currentPage={meta.page} 
            totalPages={meta.pageCount} 
            baseUrl="/noticias"
          />
        </>
      ) : (
        <p class="sem-noticias">Não foram encontradas notícias.</p>
      )
    }
  </section>
</Layout>

<style>
  .todas-noticias {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 60px 24px;
  }

  .voltar {
    display: inline-block;
    color: var(--cor-principal);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 32px;
    transition: opacity 0.2s ease;
  }

  .voltar:hover {
    opacity: 0.7;
  }

  h1 {
    font-family: var(--fonte-titulo);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--cor-principal);
    margin-bottom: 8px;
  }

  h1::after {
    content: "";
    display: block;
    width: 52px;
    height: 3px;
    background: var(--cor-destaque);
    margin-top: 14px;
    border-radius: 2px;
  }

  .section-desc {
    color: var(--cor-texto-suave);
    margin-bottom: 40px;
  }

  .sem-noticias {
    color: var(--cor-texto-suave);
    font-style: italic;
    text-align: center;
    margin-top: 40px;
  }
</style>
