---
// Página de detalhe de uma notícia (rota dinâmica [id] = slug da notícia)
// Nota: `prerender = false` implica SSR/on-demand. Em produção, o `astro build`
// exige um adapter (ex.: node, vercel, netlify). Em dev, funciona sem adapter.
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardNoticia from "../../components/CardNoticia.astro";
import Autor from "../../components/Autor.astro";
import { getRichText, getImageUrl, formatDate, isNewsPrivate, checkAuth, normalize } from "../../utils/strapi";
import PrivateOverlay from "../../components/PrivateOverlay.astro";
import ShareMenu from "../../components/ShareMenu.astro";
import ReadingProgressBar from "../../components/ReadingProgressBar.astro";
import AudioReader from "../../components/AudioReader.astro";

// URL base do Strapi e slug recebido pela rota
const STRAPI_URL = import.meta.env.STRAPI_URL?.replace(/\/$/, '');
const { id } = Astro.params;

// 1. Estado de autenticação usando helper
const isAuthenticated = checkAuth(Astro.cookies);

// 2. Busca a notícia primeiro para saber se é privada
let res: any = { data: [] };
try {
  // Tenta buscar por slug primeiro (que é o padrão)
  const query = `filters[slug][$eq]=${encodeURIComponent(id || '')}&populate[capa]=*&populate[categorias]=*&populate[autor][populate][foto]=*&populate[autor][populate][0]=*`;
  let url = `${STRAPI_URL}/api/noticias?${query}`;
  
  let response = await fetch(url);
  if (response.ok) {
    res = await response.json();
  }

  // Se não encontrar por slug e o ID parecer um número, tenta buscar por ID direto
  if ((!res.data || res.data.length === 0) && id && /^\d+$/.test(id)) {
    url = `${STRAPI_URL}/api/noticias/${id}?populate[capa]=*&populate[categorias]=*&populate[autor][populate][foto]=*&populate[autor][populate][0]=*`;
    response = await fetch(url);
    if (response.ok) {
      const singleRes = await response.json();
      // Ajusta o formato de resposta de item único para array para manter a consistência
      if (singleRes.data) {
        res = { data: [singleRes.data] };
      }
    }
  }

  // Se ainda assim não houver autor ou foto e falhou, tenta um populate mais simples como fallback
  if (!res.data || res.data.length === 0) {
     const fallbackUrl = `${STRAPI_URL}/api/noticias?filters[slug][$eq]=${encodeURIComponent(id || '')}&populate=*`;
     const fallbackRes = await fetch(fallbackUrl);
     if (fallbackRes.ok) {
       res = await fallbackRes.json();
     }
  }
} catch (e) {
  // Erro silencioso em produção
}

// Normaliza o objeto de notícia usando o utilitário global
const noticia = normalize(res.data?.[0]);

// 3. BLOQUEIO CRÍTICO: Se for privada e não houver login
const isPrivate = isNewsPrivate(noticia);

// Removido o Astro.redirect automático para permitir mostrar o "Preview Bloqueado"
const showLockScreen = isPrivate && !isAuthenticated;

// Notícias relacionadas (mesmas categorias). Usamos `slug` para evitar incluir a própria notícia.
let relatedNews: any[] = [];
if (noticia) {
  const cats: any[] = Array.isArray(noticia.categorias) ? noticia.categorias : [];

  const catSlugs = cats
    .map((c: any) => c.slug)
    .filter(Boolean);

  if (catSlugs.length > 0) {
    // Constrói os filtros de categoria para a query
    const catFilters = catSlugs
      .map((slug, index) => `filters[categorias][slug][$in][${index}]=${slug}`)
      .join("&");

    const url = `${STRAPI_URL}/api/noticias?${catFilters}&filters[slug][$ne]=${encodeURIComponent(id || '')}&populate=*&pagination[pageSize]=3&sort=publishedAt:desc`;
    
    try {
      const relatedRes = await fetch(url).then((r) => r.json());
      relatedNews = normalize(relatedRes.data) ?? [];
    } catch (e) {
      // Falha silenciosa
    }
  }
}

---

<Layout titulo={noticia?.titulo}>
  {!showLockScreen && <ReadingProgressBar />}
  <Navbar isHome={false} />

  { !noticia ? (
    <section class="detalhe">
      <a href="/" class="voltar">← Voltar</a>
      <h1>Notícia não encontrada</h1>
      <p>Verifique se o link está correto ou se a notícia foi removida.</p>
    </section>
  ) : showLockScreen ? (
    <section class="detalhe reveal">
      <a href="/" class="voltar">← Voltar</a>
      
      {/* Título AGORA EM CIMA da notícia */}
      <h1>{noticia?.titulo}</h1>

      {noticia?.autor && (
        <div class="meta-header" style="margin-bottom: 24px;">
          <div class="meta-left">
            <Autor autor={noticia.autor} />
            {noticia.publishedAt && (
              <span class="detalhe-data">{formatDate(noticia.publishedAt)}</span>
            )}
          </div>
        </div>
      )}

      <div class="lock-container">
        <div class="lock-image-wrapper">
          {getImageUrl(noticia?.capa) && (
            <img
              src={getImageUrl(noticia?.capa)}
              alt={noticia?.titulo}
              class="detalhe-img blurred"
            />
          )}
          <div class="lock-overlay">
            <PrivateOverlay variant="full" />
            
            {/* Botão de Login Bem Visível */}
            <div class="auth-cta-wrapper">
              <a href="/login" class="login-redirect-btn">
                <span>Iniciar Sessão para Ler</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
              </a>
              <p class="auth-hint">Ainda não tem conta? <a href="/registo">Registe-se aqui</a></p>
            </div>
          </div>
        </div>
        <div class="lock-preview-text">
          <div class="skeleton-line"></div>
          <div class="skeleton-line short"></div>
          <div class="skeleton-line"></div>
        </div>
      </div>
    </section>
  ) : (
    <>
      {/* Conteúdo principal do detalhe */}
      <section class="detalhe">
        <a href="/" class="voltar">← Voltar</a>

        {
          getImageUrl(noticia?.capa) && (
            <img
              src={getImageUrl(noticia?.capa)}
              alt={noticia?.titulo}
              class="detalhe-img"
            />
          )
        }

        <div class="meta-header">
          <div class="meta-left">
            {noticia?.autor && <Autor autor={noticia.autor} />}
            {noticia?.publishedAt && (
              <span class="detalhe-data">{formatDate(noticia.publishedAt)}</span>
            )}
            <AudioReader />
          </div>
          <div class="meta-right">
            {isAuthenticated && (
              <button 
                class="bookmark-btn" 
                aria-label="Guardar para ler depois" 
                data-bookmark-id={noticia?.slug} 
                data-noticia-info={JSON.stringify({
                  id: noticia?.slug,
                  titulo: noticia?.titulo,
                  imagem: getImageUrl(noticia?.capa),
                  data: formatDate(noticia?.publishedAt)
                })}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
              </button>
            )}
            <ShareMenu />
          </div>
        </div>

        <h1>{noticia?.titulo}</h1>
        <div class="detalhe-texto">{getRichText(noticia?.conteudo)}</div>

        {noticia?.autor && (
          <div class="autor-footer">
            <Autor autor={noticia.autor} variant="large" />
          </div>
        )}
      </section>

      {
        relatedNews.length > 0 && (
          <section class="relacionadas">
            <h2>Notícias relacionadas</h2>
            <div class="noticias-grid">
              {relatedNews.map((n: any) => (
                <CardNoticia noticia={n} />
              ))}
            </div>
          </section>
        )
      }
    </>
  )}
</Layout>

<style>
  .detalhe {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px 24px;
  }

  .voltar {
    display: inline-block;
    color: var(--cor-principal);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 32px;
    transition: opacity 0.2s ease;
  }

  .voltar:hover {
    opacity: 0.7;
  }

  .detalhe-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--raio);
    margin-bottom: 32px;
    box-shadow: var(--sombra);
  }

  .detalhe-img.blurred {
    filter: blur(15px) brightness(0.5);
    transform: scale(1.02);
  }

  .detalhe-data {
    display: block;
    font-size: 0.85rem;
    color: var(--cor-destaque);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 20px;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h1 {
    font-family: var(--fonte-titulo);
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.1;
    color: var(--cor-principal);
    margin-bottom: 32px;
  }

  .detalhe-texto {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--cor-texto);
    text-align: justify;
  }

  .detalhe-texto :global(p) {
    margin-bottom: 24px;
  }

  .autor-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--cor-borda);
    opacity: 0.9;
  }

  /* Estilos do Bloqueio */
  .lock-container {
    position: relative;
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--cor-fundo-card);
    border: 1px solid var(--cor-borda);
  }

  .lock-image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .lock-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    z-index: 10;
  }

  .login-redirect-btn {
    background: var(--cor-destaque);
    color: var(--cor-fundo) !important;
    text-decoration: none !important;
    padding: 16px 32px;
    border-radius: var(--raio);
    font-weight: 700;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    border: none;
    cursor: pointer;
  }

  .login-redirect-btn:hover {
    transform: translateY(-3px) scale(1.02);
    filter: brightness(1.1);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
  }

  /* Inversão de cor para o ícone do botão se necessário */
  .login-redirect-btn svg {
    color: inherit;
  }

  .auth-cta-wrapper {
    margin-top: 32px;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .auth-hint {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6) !important;
    margin: 0 !important;
  }

  .auth-hint a {
    color: var(--cor-destaque);
    text-decoration: none;
    font-weight: 600;
  }

  .auth-hint a:hover {
    text-decoration: underline;
  }

  .lock-preview-text {
    padding: 40px;
  }

  .skeleton-line {
    height: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    margin-bottom: 12px;
    width: 100%;
  }

  .skeleton-line.short {
    width: 60%;
  }

  /* Relacionadas */
  .relacionadas {
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid var(--cor-borda);
    padding: 80px 24px;
    margin-top: 60px;
  }

  .relacionadas h2 {
    max-width: 800px;
    margin: 0 auto 40px;
  }

  /* Animação */
  .reveal {
    animation: fadeIn 0.8s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function setupBookmarks() {
    console.log("Setting up bookmarks on detail page...");
    const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
    
    const getSavedNews = () => {
      const saved = localStorage.getItem('ler-depois');
      return saved ? JSON.parse(saved) : [];
    };
    
    const updateButtonsState = () => {
      const savedNews = getSavedNews();
      const savedIds = savedNews.map((n: any) => n.id);
      document.querySelectorAll('.bookmark-btn').forEach(btn => {
        const id = btn.getAttribute('data-bookmark-id');
        if (id && savedIds.includes(id)) {
          btn.classList.add('is-saved');
        } else {
          btn.classList.remove('is-saved');
        }
      });
    };

    bookmarkBtns.forEach(btn => {
      const b = btn as HTMLButtonElement;
      // Remove listener antigo para evitar duplicados
      const newBtn = b.cloneNode(true) as HTMLButtonElement;
      if (b.parentNode) {
        b.parentNode.replaceChild(newBtn, b);

        newBtn.addEventListener('click', (e) => {
          console.log("Bookmark clicked!");
          e.preventDefault();
          e.stopPropagation();
          
          const id = newBtn.getAttribute('data-bookmark-id');
          const infoStr = newBtn.getAttribute('data-noticia-info');
          if (!id || !infoStr) return;

          const noticiaInfo = JSON.parse(infoStr);
          let savedNews = getSavedNews();
          
          const index = savedNews.findIndex((n: any) => n.id === id);
          if (index > -1) {
            savedNews.splice(index, 1);
            newBtn.classList.remove('is-saved');
          } else {
            savedNews.push(noticiaInfo);
            newBtn.classList.add('is-saved');
          }
          
          localStorage.setItem('ler-depois', JSON.stringify(savedNews));
          window.dispatchEvent(new CustomEvent('bookmarks-updated'));
        });
      }
    });

    updateButtonsState();

    // Ouvir mudanças externas (outras abas ou outros componentes)
    window.removeEventListener('bookmarks-updated', updateButtonsState);
    window.addEventListener('bookmarks-updated', updateButtonsState);
  }

  // Corre imediatamente e também após trocas de página do Astro (View Transitions)
  setupBookmarks();
  document.addEventListener('astro:page-load', setupBookmarks);
  document.addEventListener('astro:after-swap', setupBookmarks);
</script>
