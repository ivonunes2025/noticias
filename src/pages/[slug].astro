---
// Rota dinâmica para páginas institucionais (Quem Somos, Termos, etc.)
// Baseado no slug vindo do Strapi.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getRichText, getImageUrl, renderBlocks } from "../utils/strapi";

const STRAPI_BASE = import.meta.env.STRAPI_URL;
const STRAPI = STRAPI_BASE?.replace(/\/$/, '');
const { slug } = Astro.params;

// Busca os dados da página por slug
const res = await fetch(`${STRAPI}/api/paginas?filters[slug][$eq]=${slug}&populate=*`).then(r => r.json());
const rawData = res.data?.[0];
const pagina = rawData?.attributes ?? rawData;

// DEBUG: Verificar estrutura da página
console.log('--- DEBUG PÁGINA COMPLETA ---');
console.log('Campos encontrados:', Object.keys(pagina || {}));
console.log('Conteúdo:', JSON.stringify(pagina?.conteudo)?.slice(0, 100));
console.log('Capa:', JSON.stringify(pagina?.capa));
// ------------------------------------

// Se não houver página, Astro.redirect ou 404
if (!pagina) {
  return Astro.redirect('/404');
}

// Verifica se há blocos ou texto simples para o conteúdo
const contentHtml = renderBlocks(pagina.conteudo) || getRichText(pagina.conteudo);

// Se não houver 'capa', tenta procurar outros campos comuns de imagem
const imagemCapa = pagina.capa || pagina.imagem || pagina.image || pagina.Hero;
const urlCapa = getImageUrl(imagemCapa);
---

<Layout titulo={pagina.titulo}>
  <Navbar isHome={false} />

  <main class="legal-page">
    <div class="legal-container">
      <a href="/" class="voltar">← Voltar</a>
      
      <h1>{pagina.titulo}</h1>

      <div class="content-container">
        <div class="content-body is-collapsed" id="content-body" set:html={contentHtml}>
        </div>
        <div class="content-overlay" id="content-overlay"></div>
      </div>
      
      <button id="toggle-content" class="read-more-btn">
        <span>Ver mais</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>

      {/* Imagem de capa - Movida para baixo do conteúdo */}
      <div class="hero-container">
        {urlCapa && (
          <img 
            src={urlCapa} 
            alt={pagina.titulo} 
            class="page-hero" 
          />
        )}
      </div>

      {/* Secção de Contacto (Visível em todas as páginas institucionais) */}
      <div class="page-footer-cta">
        <div class="cta-divider"></div>
        <div class="cta-content">
          <h2>Ficou com alguma dúvida?</h2>
          <p>Estamos disponíveis para esclarecer qualquer questão sobre o nosso projeto ou políticas.</p>
          <button onclick="window.location.href='/contacto'" class="contact-btn">
            Contacte-nos
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </div>
      </div>

      {/* Secção de Estatísticas (Apenas para Quem Somos) */}
      {slug === 'quem-somos' && (
        <div class="quem-somos-extras">
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="stat-info">
                <span class="stat-value">24/7</span>
                <span class="stat-label">Notícias em Tempo Real</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="stat-info">
                <span class="stat-value">+10k</span>
                <span class="stat-label">Visitantes Mensais</span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .legal-page {
    padding: 120px 24px 80px;
    background: var(--cor-fundo);
    min-height: 80vh;
  }

  .legal-container {
    max-width: 800px;
    margin: 0 auto;
    color: var(--cor-texto);
  }

  .voltar {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .voltar:hover {
    color: var(--cor-destaque);
  }

  .hero-container {
    position: relative;
    width: 100%;
    margin: 60px 0 40px;
    border-radius: var(--raio);
    overflow: hidden;
    aspect-ratio: 21 / 9;
  }

  .page-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: var(--sombra);
  }

  h1 {
    font-family: var(--fonte-titulo);
    font-size: 3rem;
    margin-bottom: 24px;
    color: var(--cor-principal);
  }

  /* ── Secção de Contacto (CTA) ── */
  .page-footer-cta {
    margin-top: 80px;
    padding-top: 40px;
  }

  .cta-divider {
    height: 1px;
    background: linear-gradient(to right, var(--cor-destaque-claro) 0%, transparent 100%);
    margin-bottom: 40px;
    opacity: 0.3;
  }

  .cta-content {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .cta-content h2 {
    font-family: var(--fonte-titulo);
    font-size: 2rem;
    color: var(--cor-principal);
    margin: 0;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
    max-width: 500px;
    margin: 0;
  }

  .contact-btn {
    background: var(--cor-destaque);
    color: var(--cor-fundo);
    padding: 16px 32px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
  }

  .contact-btn:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px var(--cor-destaque-claro);
  }

  .contact-btn svg {
    transition: transform 0.2s ease;
  }

  .contact-btn:hover svg {
    transform: translateX(4px);
  }

  /* ── Estilos do "Ver mais" ── */
  .content-container {
    position: relative;
    overflow: hidden;
  }

  .content-body {
    line-height: 1.8;
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
    text-align: justify;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Altura aproximada para 6 linhas (1.1rem * 1.8 * 6 ≈ 12rem ou 192px) */
  .content-body.is-collapsed {
    max-height: 200px; /* Ajuste para ~6 linhas dependendo da fonte */
  }

  .content-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, var(--cor-fundo) 100%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .is-expanded + .content-overlay {
    opacity: 0;
  }

  .read-more-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--cor-destaque-claro);
    color: var(--cor-destaque);
    padding: 10px 20px;
    border-radius: 50px;
    font-weight: 500;
    cursor: pointer;
    margin: 24px auto 0;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .read-more-btn:hover {
    background: var(--cor-destaque-claro);
    border-color: var(--cor-destaque);
  }

  .read-more-btn svg {
    transition: transform 0.3s ease;
  }

  .read-more-btn.is-active svg {
    transform: rotate(180deg);
  }

  .content-body :global(p) {
    margin-bottom: 24px;
  }

  .content-body :global(h2) {
    font-family: var(--fonte-corpo);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 2px;
    color: var(--cor-destaque);
    margin-top: 32px;
  }

  /* ── Estilos Especiais Quem Somos (Stats & CTA) ── */
  .quem-somos-extras {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-bottom: 60px;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--raio);
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-4px);
    border-color: var(--cor-destaque-claro);
  }

  .stat-icon {
    width: 60px;
    height: 60px;
    background: var(--cor-destaque-claro);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cor-destaque);
    flex-shrink: 0;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-family: var(--fonte-titulo);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--cor-principal);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--cor-texto-suave);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Imagens dentro do texto rico */
  .content-body :global(.rich-image-container) {
    margin: 40px 0;
    width: 100%;
    text-align: center;
  }

  .content-body :global(.rich-image) {
    max-width: 100%;
    height: auto;
    border-radius: var(--raio);
    box-shadow: var(--sombra);
  }

  @media (max-width: 768px) {
    .legal-page {
      padding-top: 80px;
    }
    
    h1 {
      font-size: 2.25rem;
    }
  }
</style>

<script>
  function setupReadMore() {
    const toggleBtn = document.getElementById('toggle-content');
    const contentBody = document.getElementById('content-body') as HTMLElement;
    const contentOverlay = document.getElementById('content-overlay') as HTMLElement;

    if (!toggleBtn || !contentBody) return;

    // Se o conteúdo for menor que o limite, esconde o botão
    if (contentBody.scrollHeight <= 200) {
      toggleBtn.style.display = 'none';
      if (contentOverlay) contentOverlay.style.display = 'none';
      contentBody.classList.remove('is-collapsed');
      return;
    }

    toggleBtn.addEventListener('click', () => {
      const isCollapsed = contentBody.classList.contains('is-collapsed');
      
      if (isCollapsed) {
        // Expandir
        contentBody.classList.remove('is-collapsed');
        contentBody.style.maxHeight = contentBody.scrollHeight + 'px';
        toggleBtn.classList.add('is-active');
        const span = toggleBtn.querySelector('span');
        if (span) span.innerText = 'Ver menos';
        if (contentOverlay) contentOverlay.style.opacity = '0';
      } else {
        // Colapsar
        contentBody.classList.add('is-collapsed');
        contentBody.style.maxHeight = '200px';
        toggleBtn.classList.remove('is-active');
        const span = toggleBtn.querySelector('span');
        if (span) span.innerText = 'Ver mais';
        if (contentOverlay) contentOverlay.style.opacity = '1';
        
        // Opcional: Voltar para o início do conteúdo se estiver muito abaixo
        const rect = contentBody.getBoundingClientRect();
        if (rect.top < 0) {
          window.scrollTo({
            top: window.scrollY + rect.top - 150,
            behavior: 'smooth'
          });
        }
      }
    });
  }

  // Executa no carregamento e após transições de página (se houver ViewTransitions)
  setupReadMore();
  document.addEventListener('astro:after-swap', setupReadMore);
</script>
