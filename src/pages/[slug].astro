---
// Rota dinâmica para páginas institucionais (Quem Somos, Termos, etc.)
// Baseado no slug vindo do Strapi.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getRichText, getImageUrl, renderBlocks } from "../utils/strapi";

const STRAPI_BASE = import.meta.env.STRAPI_URL;
const STRAPI = STRAPI_BASE?.replace(/\/$/, '');
const { slug } = Astro.params;

// Busca os dados da página por slug e todas as páginas para o menu
const [currentPageRes, allPagesRes] = await Promise.all([
  fetch(`${STRAPI}/api/paginas?filters[slug][$eq]=${slug}&populate=*`).then(r => r.json()).catch(() => ({ data: [] })),
  fetch(`${STRAPI}/api/paginas?filters[visivel][$ne]=false&fields[0]=titulo&fields[1]=slug&sort=titulo:asc`).then(r => r.json()).catch(() => ({ data: [] }))
]);

const rawData = currentPageRes.data?.[0];
const pagina = rawData?.attributes ?? rawData;

// Se não houver página, redireciona para 404
if (!pagina) {
  return Astro.redirect('/404');
}

// Se a página estiver oculta
if (pagina.visivel === false) {
  return Astro.redirect('/404');
}

const allPages = (allPagesRes.data ?? []).map((p: any) => p.attributes ?? p);

const contentHtml = renderBlocks(pagina.conteudo) || getRichText(pagina.conteudo);
const imagemCapa = pagina.capa || pagina.imagem || pagina.image || pagina.Hero;
const urlCapa = getImageUrl(imagemCapa);
---

<Layout titulo={pagina.titulo}>
  <Navbar isHome={false} />

  <div class="legal-dashboard">
    <div class="legal-dashboard-inner">
      
      <!-- Sidebar de Navegação -->
      <aside class="legal-sidebar">
        <div class="sidebar-nav-card glass-panel">
          <h3>Navegação</h3>
          <nav class="sidebar-menu">
            {allPages.map((p: any) => (
              <a 
                href={`/${p.slug}`} 
                class={`sidebar-menu-item ${p.slug === slug ? 'active' : ''}`}
              >
                <span>{p.titulo}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>
            ))}
            <a 
              href="/contacto" 
              class="sidebar-menu-item"
            >
              <span>Contacto</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </nav>
        </div>
      </aside>

      <!-- Conteúdo Principal -->
      <main class="legal-main">
        <article class="legal-card glass-panel">
          <a href="/" class="voltar">← Voltar para a Home</a>
          
          <header class="page-header">
            <h1>{pagina.titulo}</h1>
          </header>

          <div class="content-body" set:html={contentHtml}>
          </div>

          <!-- Imagem de capa - se existir -->
          {urlCapa && (
            <div class="hero-container">
              <img 
                src={urlCapa} 
                alt={pagina.titulo} 
                class="page-hero" 
                loading="eager"
              />
            </div>
          )}
        </article>

        {/* Secção de Estatísticas (Apenas para Quem Somos) */}
        {slug === 'quem-somos' && (
          <div class="quem-somos-extras">
            <div class="stats-grid">
              <div class="stat-card glass-panel">
                <div class="stat-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="stat-info">
                  <span class="stat-value">24/7</span>
                  <span class="stat-label">Notícias em Tempo Real</span>
                </div>
              </div>
              <div class="stat-card glass-panel">
                <div class="stat-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="stat-info">
                  <span class="stat-value">+10k</span>
                  <span class="stat-label">Visitantes Mensais</span>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- CTA de Contacto -->
        <div class="page-footer-cta glass-panel">
          <div class="cta-content">
            <h2>Ficou com alguma dúvida?</h2>
            <p>Estamos sempre disponíveis para ajudar e responder a qualquer questão sobre as nossas políticas.</p>
            <button onclick="window.location.href='/contacto'" class="contact-btn">
              Contacte-nos
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        </div>
      </main>

    </div>
  </div>
</Layout>

<style>
  :root {
    --dash-radius: 16px;
    --transition-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .legal-dashboard {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 100px 20px 60px;
    box-sizing: border-box;
    min-height: calc(100vh - 100px);
    animation: fadeIn 0.6s ease-out forwards;
  }

  .legal-dashboard-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .legal-dashboard-inner {
      grid-template-columns: 260px 1fr;
      gap: 32px;
    }
    .legal-sidebar {
      position: sticky;
      top: 100px;
    }
  }

  /* glass-panel base */
  .glass-panel {
    background: var(--cor-fundo-card);
    border-radius: var(--dash-radius);
    border: 1px solid var(--cor-borda);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
  }

  /* Sidebar */
  .sidebar-nav-card {
    padding: 24px;
  }

  .sidebar-nav-card h3 {
    font-family: var(--fonte-titulo);
    font-size: 1.1rem;
    color: var(--cor-principal);
    margin-top: 0;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--cor-borda);
    padding-bottom: 10px;
  }

  .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sidebar-menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.92rem;
    color: var(--cor-texto-suave);
    transition: all 0.25s ease;
    text-decoration: none;
    font-weight: 500;
  }

  .sidebar-menu-item:hover {
    color: var(--cor-principal);
    background: rgba(255, 255, 255, 0.04);
  }

  .sidebar-menu-item.active {
    color: var(--cor-destaque);
    background: var(--cor-destaque-claro);
    font-weight: 600;
  }

  .sidebar-menu-item svg {
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s ease;
  }

  .sidebar-menu-item:hover svg,
  .sidebar-menu-item.active svg {
    opacity: 1;
    transform: translateX(0);
  }

  /* Main / Article */
  .legal-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .legal-card {
    padding: 40px;
  }

  .voltar {
    display: inline-flex;
    align-items: center;
    color: var(--cor-destaque);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 24px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .voltar:hover {
    transform: translateX(-4px);
    opacity: 0.9;
  }

  .page-header h1 {
    font-family: var(--fonte-titulo);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    color: var(--cor-principal);
    margin-top: 0;
    margin-bottom: 32px;
    line-height: 1.2;
  }

  /* Typography inside content-body */
  .content-body {
    line-height: 1.8;
    font-size: 1.05rem;
    color: var(--cor-texto);
  }

  .content-body :global(p) {
    margin-bottom: 24px;
    color: var(--cor-texto-suave);
  }

  .content-body :global(h2) {
    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 40px;
    margin-bottom: 16px;
    color: var(--cor-principal);
    border-left: 3px solid var(--cor-destaque);
    padding-left: 14px;
    line-height: 1.3;
  }

  .content-body :global(h3) {
    font-family: var(--fonte-titulo);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 30px;
    margin-bottom: 12px;
    color: var(--cor-principal);
  }

  .content-body :global(ul), .content-body :global(ol) {
    margin-left: 24px;
    margin-bottom: 24px;
    color: var(--cor-texto-suave);
  }

  .content-body :global(li) {
    margin-bottom: 8px;
  }

  .content-body :global(strong) {
    color: var(--cor-principal);
    font-weight: 600;
  }

  .hero-container {
    position: relative;
    width: 100%;
    margin-top: 40px;
    border-radius: var(--raio);
    overflow: hidden;
    aspect-ratio: 21 / 9;
  }

  .page-hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: var(--sombra);
  }

  /* CTA */
  .page-footer-cta {
    padding: 40px;
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .cta-content h2 {
    font-family: var(--fonte-titulo);
    font-size: 1.8rem;
    color: var(--cor-principal);
    margin: 0;
  }

  .cta-content p {
    font-size: 1rem;
    color: var(--cor-texto-suave);
    max-width: 500px;
    margin: 0;
    line-height: 1.6;
  }

  .contact-btn {
    background: var(--cor-destaque);
    color: var(--cor-fundo);
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
  }

  .contact-btn:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--cor-destaque-claro);
  }

  .contact-btn svg {
    transition: transform 0.2s ease;
  }

  .contact-btn:hover svg {
    transform: translateX(4px);
  }

  /* Quem somos special styles */
  .quem-somos-extras {
    margin-top: 12px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .stat-card {
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-4px);
    border-color: var(--cor-destaque-claro);
  }

  .stat-icon {
    width: 54px;
    height: 54px;
    background: var(--cor-destaque-claro);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cor-destaque);
    flex-shrink: 0;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-family: var(--fonte-titulo);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--cor-principal);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--cor-texto-suave);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .legal-dashboard {
      padding-top: 80px;
    }
    .legal-card {
      padding: 24px;
    }
    .page-footer-cta {
      padding: 32px 20px;
    }
  }
</style>