---
// src/pages/autores/[slug].astro
// Página de perfil de um autor que lista todos os seus artigos.
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardNoticia from "../../components/CardNoticia.astro";
import Pagination from "../../components/Pagination.astro";
import { normalize, getImageUrl, fetchStrapi, formatTituloPt } from "../../utils/strapi";

const { slug } = Astro.params;
const page = Number(Astro.url.searchParams.get("page") || 1);
const pageSize = 9;

// 1. Busca o autor pelo slug no Strapi
let autorRes = await fetchStrapi('autors', {
  'filters[slug][$eq]': slug ?? "",
  'populate': '*'
});

// Normaliza o resultado
const autoresList = normalize(autorRes);
let autor = Array.isArray(autoresList) ? autoresList[0] : (autoresList || null);

// Tenta também por ID se slug falhar
if (!autor && slug) {
  const resId = await fetchStrapi(`autors/${slug}`, { populate: '*' });
  autor = normalize(resId);
}

// Se não houver autor, redireciona para 404
if (!autor) {
  return Astro.redirect('/404');
}

const fotoUrl = getImageUrl(autor.foto);

// 2. Busca as notícias associadas a este autor
const noticiasRes = await fetchStrapi('noticias', {
  'filters[autor][slug][$eq]': autor.slug ?? "",
  'populate': '*',
  'pagination[page]': page,
  'pagination[pageSize]': pageSize,
  'sort': 'publishedAt:desc'
});

const news = normalize(noticiasRes) || [];
const meta = noticiasRes?.meta?.pagination || { page: 1, pageSize: 9, pageCount: 1, total: 0 };
---

<Layout titulo={`${autor.nome} — Autor`}>
  <Navbar isHome={false} />

  <main class="autor-page">
    <div class="autor-hero">
      <a href="/" class="voltar">← Voltar</a>
      
      <div class="autor-profile">
        <div class="autor-avatar">
          {fotoUrl ? (
            <img src={fotoUrl} alt={autor.nome} class="avatar-img" />
          ) : (
            <div class="avatar-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
          )}
        </div>

        <div class="autor-info">
          <span class="autor-label">Autor</span>
          <h1>{autor.nome}</h1>
          {autor.cargo && <p class="autor-cargo">{autor.cargo}</p>}
          <div class="autor-stats">
            <span class="stat-number">{meta.total}</span>
            <span class="stat-text">{meta.total === 1 ? " artigo publicado" : " artigos publicados"}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="autor-noticias">
      {news.length > 0 ? (
        <>
          <h2 class="section-title">Artigos de {autor.nome}</h2>
          <div class="noticias-grid">
            {news.map((n: any) => (
              <CardNoticia noticia={n} />
            ))}
          </div>

          <Pagination 
            currentPage={meta.page} 
            totalPages={meta.pageCount} 
            baseUrl={`/autores/${slug}`}
          />
        </>
      ) : (
        <div class="sem-noticias">
          <p>Este autor ainda não tem artigos publicados.</p>
          <a href="/" class="btn-home">Ir para a Página Inicial</a>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .autor-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 60px 24px 80px;
  }

  .voltar {
    display: inline-block;
    color: var(--cor-principal);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 40px;
    transition: opacity 0.2s ease;
  }
  .voltar:hover { opacity: 0.7; }

  .autor-hero {
    margin-bottom: 60px;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--cor-borda);
  }

  .autor-profile {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .autor-avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--cor-destaque);
    flex-shrink: 0;
    background: var(--cor-fundo-card);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .autor-info {
    flex: 1;
    min-width: 280px;
  }

  .autor-label {
    display: block;
    font-size: 0.8rem;
    color: var(--cor-destaque);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .autor-info h1 {
    font-family: var(--fonte-titulo);
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    color: var(--cor-principal);
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .autor-cargo {
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
    margin: 0 0 16px 0;
    font-weight: 500;
  }

  .autor-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--cor-fundo-card);
    padding: 8px 16px;
    border-radius: 50px;
    width: fit-content;
    border: 1px solid var(--cor-borda);
  }

  .stat-number {
    font-weight: 800;
    color: var(--cor-destaque);
    font-size: 1.1rem;
  }

  .stat-text {
    font-size: 0.9rem;
    color: var(--cor-texto);
    font-weight: 500;
  }

  .section-title {
    font-family: var(--fonte-titulo);
    font-size: 1.8rem;
    color: var(--cor-principal);
    margin-bottom: 40px;
  }

  .noticias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
    margin-bottom: 60px;
  }

  .sem-noticias {
    text-align: center;
    padding: 80px 24px;
    background: var(--cor-fundo-card);
    border-radius: var(--raio);
    border: 1px dashed var(--cor-borda);
  }

  .sem-noticias p {
    font-size: 1.1rem;
    color: var(--cor-texto-suave);
    margin-bottom: 24px;
  }

  .btn-home {
    display: inline-block;
    padding: 12px 24px;
    background: var(--cor-destaque);
    color: var(--cor-fundo);
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-home:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(200, 150, 62, 0.3);
  }

  @media (max-width: 768px) {
    .autor-profile {
      flex-direction: column;
      text-align: center;
      gap: 24px;
    }
    .autor-stats {
      margin: 0 auto;
    }
    .autor-avatar {
      width: 120px;
      height: 120px;
    }
  }
</style>
