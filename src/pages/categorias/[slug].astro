---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CardNoticia from "../../components/CardNoticia.astro";
import Pagination from "../../components/Pagination.astro";
import { formatTituloPt, fetchStrapi, normalize } from "../../utils/strapi";

const { slug } = Astro.params;
const slugEncoded = encodeURIComponent(slug ?? "");

// Paginação
const page = Number(Astro.url.searchParams.get("page") || 1);
const pageSize = 9; // Número de notícias por página

const [categoriaRes, noticiasRes] = await Promise.all([
  fetchStrapi(`categorias`, {
    'filters[slug][$eq]': slug ?? ""
  }),
  fetchStrapi(`noticias`, {
    'filters[categorias][slug][$eq]': slug ?? "",
    'populate[categorias][fields][0]': 'slug',
    'populate[categorias][fields][1]': 'nome',
    'populate[capa][fields][0]': 'url',
    'pagination[page]': page,
    'pagination[pageSize]': pageSize,
    'sort': 'publishedAt:desc'
  }),
]);

const categoriaData = normalize(categoriaRes?.[0]);
const nomeCategoriaRaw = categoriaData?.nome ?? categoriaData?.name ?? slug ?? "";
const nomeCategoria = formatTituloPt(nomeCategoriaRaw);

const news = normalize(noticiasRes);
const meta = noticiasRes?.meta?.pagination || { page: 1, pageSize: 9, pageCount: 1, total: 0 };

// Estado de autenticação (Cookies) para filtrar notícias privadas
const userCookie = Astro.cookies.get('user_name');
const isAuthenticated = !!userCookie?.value;
---

<Layout titulo={`${nomeCategoria} - Categorias`}>
  <Navbar isHome={false} />

  <section class="categoria-detalhe">
    <a href="/" class="voltar">← Voltar</a>
    <h1>{nomeCategoria}</h1>
    <p class="categoria-desc">
      Notícias na categoria {nomeCategoria}.
    </p>

    {
      news.length > 0 ? (
        <>
          <div class="noticias-grid">
            {news.map((n: any) => (
              <CardNoticia noticia={n} />
            ))}
          </div>

          <Pagination 
            currentPage={meta.page} 
            totalPages={meta.pageCount} 
            baseUrl={`/categorias/${slug}`}
          />
        </>
      ) : (
        <p class="sem-noticias">
          Não há notícias nesta categoria. Associe notícias a esta categoria no
          Strapi.
        </p>
      )
    }
  </section>
<style>
  .categoria-detalhe {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 60px 24px;
  }

  .voltar {
    display: inline-block;
    color: var(--cor-principal);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 32px;
    transition: opacity 0.2s ease;
  }

  .voltar:hover {
    opacity: 0.7;
  }

  .categoria-detalhe h1 {
    font-family: var(--fonte-titulo);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--cor-principal);
    margin-bottom: 8px;
  }

  .categoria-detalhe h1::after {
    content: "";
    display: block;
    width: 52px;
    height: 3px;
    background: var(--cor-destaque);
    margin-top: 14px;
    border-radius: 2px;
  }

  .categoria-desc {
    color: var(--cor-texto-suave);
    margin-bottom: 40px;
  }

  .sem-noticias {
    color: var(--cor-texto-suave);
    font-style: italic;
  }
</style>
</Layout>