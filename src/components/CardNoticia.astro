---
// CardNoticia.astro
// Componente reutilizável para cartões de notícias em todo o site
import { getImageUrl, formatDate, getRichText, isNewsPrivate, checkAuth, normalize } from "../utils/strapi";
import { Image } from 'astro:assets';
import PrivateOverlay from "./PrivateOverlay.astro";

const { noticia: rawNoticia, horizontal = false, isLCP = false } = Astro.props;

if (!rawNoticia) return null;

// Normaliza a notícia para facilitar o acesso
const noticia = normalize(rawNoticia);

const slug = noticia.slug ?? noticia.id;
const imagemUrl = getImageUrl(noticia.capa ?? noticia.imagem) || "/placeholder.jpg";
const dataFormatada = formatDate(noticia.publishedAt);
const resumo = getRichText(noticia.conteudo || noticia.resumo).slice(0, 140) + "...";

// Verifica se é privada e autenticação usando helpers
const isPrivateField = isNewsPrivate(noticia);
const isAuthenticated = checkAuth(Astro.cookies);

// Só mostra como bloqueada se for privada E o utilizador não estiver logado
const showBlocked = isPrivateField && !isAuthenticated;
---

<a href={`/noticias/${slug}`} class={`noticia-card ${horizontal ? 'noticia-card--horizontal' : ''} ${showBlocked ? 'is-private' : ''}`} data-id={noticia.slug}>
  <div class="noticia-img-wrapper">
    {showBlocked && <PrivateOverlay variant="card" />}
    
    {/* Botão de Guardar (Bookmark) */}
    {!showBlocked && (
      <button class="bookmark-btn" aria-label="Guardar para ler depois" data-bookmark-id={noticia.slug} data-noticia-info={JSON.stringify({
        id: noticia.slug,
        titulo: noticia.titulo,
        imagem: imagemUrl,
        data: dataFormatada
      })}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </button>
    )}

    {imagemUrl.startsWith('http') && !imagemUrl.includes('placeholder') ? (
      <Image 
        src={imagemUrl} 
        alt={noticia.titulo} 
        class={`noticia-img ${showBlocked ? 'blur-img' : ''}`} 
        width={400} 
        height={225}
        format="webp"
        quality={80}
        loading={isLCP ? "eager" : "lazy"} 
        fetchpriority={isLCP ? "high" : "auto"}
      />
    ) : (
      <img 
        src={imagemUrl} 
        alt={noticia.titulo} 
        class={`noticia-img ${showBlocked ? 'blur-img' : ''}`} 
        loading={isLCP ? "eager" : "lazy"} 
        width="400" 
        height="225" 
        fetchpriority={isLCP ? "high" : "auto"}
      />
    )}
  </div>
  <div class="noticia-corpo">
    <span class="noticia-data">{dataFormatada}</span>
    <h3 class="noticia-titulo">{noticia.titulo}</h3>
    {!horizontal && <p class="noticia-resumo">{resumo}</p>}
  </div>
</a>

<style>
  .noticia-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    background: var(--cor-fundo-card);
    border-radius: var(--raio);
    border: 1px solid var(--cor-borda);
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s ease;
    height: 100%;
  }

  /* Variante Horizontal */
  .noticia-card--horizontal {
    flex-direction: row;
    align-items: center;
    height: auto;
  }

  .noticia-card--horizontal .noticia-img-wrapper {
    width: 120px;
    height: 100px;
    flex-shrink: 0;
  }

  .noticia-card--horizontal .noticia-corpo {
    padding: 12px 16px;
  }

  .noticia-card--horizontal .noticia-titulo {
    font-size: 0.95rem;
    margin-bottom: 4px;
    -webkit-line-clamp: 2;
  }

  .noticia-card--horizontal .noticia-data {
    font-size: 0.65rem;
    margin-bottom: 4px;
  }

  .noticia-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra);
    border-color: var(--cor-destaque);
  }

  .noticia-img-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--cor-borda);
    aspect-ratio: 16 / 9;
  }

  .noticia-card:hover .noticia-img-wrapper :global(.private-overlay) {
    background: rgba(0, 0, 0, 0.4);
  }

  .bookmark-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 15;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .bookmark-btn:hover {
    transform: scale(1.1);
    background: var(--cor-destaque);
    border-color: var(--cor-destaque);
    color: var(--cor-fundo);
  }

  .bookmark-btn.is-saved {
    background: var(--cor-destaque);
    border-color: var(--cor-destaque);
    color: var(--cor-fundo);
  }

  .bookmark-btn.is-saved svg {
    fill: currentColor;
  }

  .blur-img {
    filter: blur(12px) grayscale(0.5);
    transform: scale(1.1);
  }

  .noticia-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s ease;
    display: block;
  }

  .noticia-card:not(.is-private):hover .noticia-img {
    transform: scale(1.05);
  }

  .is-private:hover .noticia-img {
    transform: scale(1.1);
  }

  .noticia-corpo {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 140px;
  }

  .noticia-data {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cor-destaque);
    margin-bottom: 8px;
    display: block;
  }

  .noticia-titulo {
    font-size: 1.1rem;
    line-height: 1.4;
    margin-bottom: 12px;
    color: var(--cor-principal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .noticia-resumo {
    font-size: 0.88rem;
    color: var(--cor-texto-suave);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .noticia-corpo {
      padding: 16px;
    }
    .noticia-titulo {
      font-size: 1rem;
    }
    .noticia-resumo {
      -webkit-line-clamp: 2;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  function setupBookmarks() {
    const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
    const getSavedNews = () => {
      const saved = localStorage.getItem('ler-depois');
      return saved ? JSON.parse(saved) : [];
    };
    const updateButtonsState = () => {
      const savedNews = getSavedNews();
      const savedIds = savedNews.map((n: any) => n.id);
      document.querySelectorAll('.bookmark-btn').forEach(btn => {
        const id = btn.getAttribute('data-bookmark-id');
        if (id && savedIds.includes(id)) {
          btn.classList.add('is-saved');
        } else {
          btn.classList.remove('is-saved');
        }
      });
    };
    bookmarkBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-bookmark-id');
        const infoStr = btn.getAttribute('data-noticia-info');
        if (!id || !infoStr) return;
        const noticiaInfo = JSON.parse(infoStr);
        let savedNews = getSavedNews();
        const index = savedNews.findIndex((n: any) => n.id === id);
        if (index > -1) {
          savedNews.splice(index, 1);
          btn.classList.remove('is-saved');
        } else {
          savedNews.push(noticiaInfo);
          btn.classList.add('is-saved');
        }
        localStorage.setItem('ler-depois', JSON.stringify(savedNews));
        window.dispatchEvent(new CustomEvent('bookmarks-updated'));
      });
    });
    updateButtonsState();
  }
  setupBookmarks();
  document.addEventListener('astro:after-swap', setupBookmarks);
</script>
