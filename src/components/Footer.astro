---
// Componente Footer: O rodapé reutilizável do site.
// Contém informações sobre o site, links para redes sociais e links legais, todos vindos da configuração central.

// Importa a configuração central do site para aceder a nomes, descrições e links.
import { SITE_CONFIG } from "../utils/config";
// Importa os estilos CSS associados a este componente.
import "../styles/footer.css";
---

<!-- A tag semântica `<footer>` para o rodapé. -->
<footer class="footer">
  <!-- O contêiner principal que centraliza e organiza o conteúdo. -->
  <div class="footer-container">
    <!-- Secção de informações do site (logo e descrição). -->
    <div class="footer-info">
      <a href="/" class="footer-logo">
        {SITE_CONFIG.nome.split(' ')[0]}<span> {SITE_CONFIG.nome.split(' ').slice(1).join(' ')}</span>
      </a>
      <p class="footer-desc">
        {SITE_CONFIG.descricao}
      </p>
    </div>

    <!-- Secção de redes sociais. -->
    <div class="footer-social">
      <h4 class="social-title">Redes Sociais</h4>
      <div class="social-links">
        <!-- Renderiza o ícone do Facebook apenas se o link estiver definido na configuração. -->
        {SITE_CONFIG.redesSociais.facebook && (
          <a href={SITE_CONFIG.redesSociais.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        )}
        <!-- Renderiza o ícone do Instagram apenas se o link estiver definido. -->
        {SITE_CONFIG.redesSociais.instagram && (
          <a href={SITE_CONFIG.redesSociais.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        )}
        <!-- Renderiza o ícone do Website apenas se o link estiver definido. -->
        {SITE_CONFIG.redesSociais.website && (
          <a href={SITE_CONFIG.redesSociais.website} target="_blank" rel="noopener noreferrer" aria-label="Website Oficial" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- A barra inferior do rodapé, com direitos de autor e links legais. -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p>&copy; {SITE_CONFIG.ano} {SITE_CONFIG.nome}. Todos os direitos reservados.</p>
      <div class="footer-bottom-links">
        <a href={SITE_CONFIG.linksLegais.termos}>Termos e Condições</a>
        <a href={SITE_CONFIG.linksLegais.privacidade}>Política de Privacidade</a>
        <!-- Renderiza o link para o Livro de Reclamações apenas se estiver definido na configuração. -->
        {SITE_CONFIG.linksLegais.livroReclamacoes && (
          <a href={SITE_CONFIG.linksLegais.livroReclamacoes} target="_blank" rel="noopener noreferrer" class="livro-reclamacoes">
            Livro de Reclamações
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
