---
// Componente Footer: O rodapé reutilizável do site.
// Os links de navegação vêm do menu footer definido no Strapi (Definição).

import { SITE_CONFIG } from "../utils/config";
import { getDefinicoes } from "../utils/definicoes";
import { getMenu } from "../utils/menus";
import type { MenuItem } from "../utils/menus";
import "../styles/footer.css";

// Busca as definições globais para obter o slug do menu footer
const definicoes = await getDefinicoes();
const menuFooterSlug = definicoes.menuFooterSlug ?? 'menu-footer';

// Busca o menu footer com os seus itens
const menuFooter = await getMenu(menuFooterSlug);
const itensFooter: MenuItem[] = menuFooter?.itens ?? [];

// Verifica se o utilizador está autenticado
const user = Astro.cookies.get('user_name')?.value;
const showNewsletter = !user;
---

<footer class="footer">
  <div class="footer-container">

    <!-- Secção de informações do site (logo e descrição) -->
    <div class="footer-info">
      <a href="/" class="footer-logo">
        {SITE_CONFIG.nome.split(' ')[0]}<span> {SITE_CONFIG.nome.split(' ').slice(1).join(' ')}</span>
      </a>
      <p class="footer-desc">
        {SITE_CONFIG.descricao}
      </p>

      {showNewsletter && (
        <div class="footer-newsletter">
          <h4>{definicoes.newsletterTitulo}</h4>
          <p>{definicoes.newsletterDescricao}</p>
          <form class="newsletter-form" id="newsletter-footer-form">
            <input 
              type="email" 
              placeholder={definicoes.newsletterPlaceholder} 
              required 
              aria-label="Email para newsletter"
            />
            <button type="submit" class="btn-newsletter">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </form>
          <div id="newsletter-message" class="newsletter-message"></div>
        </div>
      )}
    </div>

    <!-- Navegação do footer vinda do Strapi -->
    {itensFooter.length > 0 && (
      <nav class="footer-nav" aria-label="Menu footer">
        <h4 class="footer-nav-title">Navegação</h4>
        <ul class="footer-nav-list">
          {itensFooter.map((item: MenuItem) => (
            <li>
              <a
                href={item.link}
                target={item.abrir_nova_aba ? '_blank' : '_self'}
                rel={item.abrir_nova_aba ? 'noopener noreferrer' : undefined}
                class="footer-nav-link"
              >
                {item.titulo}
              </a>
              <!-- Se tiver filhos (dropdown), mostra também -->
              {item.filhos.length > 0 && (
                <ul class="footer-nav-sub">
                  {item.filhos.map((filho: MenuItem) => (
                    <li>
                      <a
                        href={filho.link}
                        target={filho.abrir_nova_aba ? '_blank' : '_self'}
                        rel={filho.abrir_nova_aba ? 'noopener noreferrer' : undefined}
                        class="footer-nav-link footer-nav-link--sub"
                      >
                        {filho.titulo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Secção de redes sociais -->
<div class="footer-social">
  <h4 class="social-title">Redes Sociais</h4>
  <div class="social-links">
    {(definicoes.facebookUrl || SITE_CONFIG.redesSociais.facebook) && (
      <a href={definicoes.facebookUrl ?? SITE_CONFIG.redesSociais.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </a>
    )}
    {(definicoes.instagramUrl || SITE_CONFIG.redesSociais.instagram) && (
      <a href={definicoes.instagramUrl ?? SITE_CONFIG.redesSociais.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    )}
    {(definicoes.websiteUrl || SITE_CONFIG.redesSociais.website) && (
      <a href={definicoes.websiteUrl ?? SITE_CONFIG.redesSociais.website} target="_blank" rel="noopener noreferrer" aria-label="Website Oficial" class="social-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>
    )}
  </div>
</div>
     
  <!-- Barra inferior com direitos de autor e links legais -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p>&copy; {SITE_CONFIG.ano} {SITE_CONFIG.nome}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<script define:vars={{ STRAPI_URL: import.meta.env.STRAPI_URL }}>
  // Lógica para o formulário de newsletter enviando para o Strapi
  const form = document.getElementById('newsletter-footer-form');
  const messageDiv = document.getElementById('newsletter-message');

  if (form && messageDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input');
      const email = input.value;

      try {
        form.classList.add('is-loading');
        messageDiv.textContent = 'A enviar...';
        messageDiv.className = 'newsletter-message';
        
        const baseUrl = STRAPI_URL.replace(/\/$/, '');
        
        // Envio para o Strapi com TODOS os campos da sua imagem
        const response = await fetch(`${baseUrl}/api/newsletter-subscritos`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            data: {
              email: email,
              subscrito: true,
              data_subscricao: new Date().toISOString()
            }
          }),
        });

        const result = await response.json();

        if (response.ok) {
          console.log('Sucesso:', result);
          messageDiv.textContent = 'Obrigado por subscrever!';
          messageDiv.className = 'newsletter-message is-success';
          form.reset();
        } else {
          console.error('Erro detalhado do Strapi:', result);
          const errorMsg = result.error?.message || 'Erro de permissão no Strapi (Public > Create).';
          messageDiv.textContent = `Erro: ${errorMsg}`;
          messageDiv.className = 'newsletter-message is-error';
        }
      } catch (err) {
        console.error('Erro de rede/ligação:', err);
        messageDiv.textContent = 'Erro de ligação. O servidor Strapi está ativo?';
        messageDiv.className = 'newsletter-message is-error';
      } finally {
        form.classList.remove('is-loading');
      }
    });
  }
</script>
