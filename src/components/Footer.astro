---
// Componente Footer: O rodapé reutilizável do site.
// Os links de navegação vêm do menu footer definido no Strapi (Definição).

import { SITE_CONFIG } from "../utils/config";
import { getDefinicoes } from "../utils/definicoes";
import { getMenu } from "../utils/menus";
import type { MenuItem } from "../utils/menus";
import "../styles/footer.css";

// Busca as definições globais para obter o slug do menu footer
const definicoes = await getDefinicoes();
const menuFooterSlug = definicoes.menuFooterSlug ?? 'menu-footer';

// Busca o menu footer com os seus itens
const menuFooter = await getMenu(menuFooterSlug);
const itensFooter: MenuItem[] = menuFooter?.itens ?? [];
---

<footer class="footer">
  <div class="footer-container">

    <!-- Secção de informações do site (logo e descrição) -->
    <div class="footer-info">
      <a href="/" class="footer-logo">
        {SITE_CONFIG.nome.split(' ')[0]}<span> {SITE_CONFIG.nome.split(' ').slice(1).join(' ')}</span>
      </a>
      <p class="footer-desc">
        {SITE_CONFIG.descricao}
      </p>
    </div>

    <!-- Navegação do footer vinda do Strapi -->
    {itensFooter.length > 0 && (
      <nav class="footer-nav" aria-label="Menu footer">
        <h4 class="footer-nav-title">Navegação</h4>
        <ul class="footer-nav-list">
          {itensFooter.map((item: MenuItem) => (
            <li>
              <a
                href={item.link}
                target={item.abrir_nova_aba ? '_blank' : '_self'}
                rel={item.abrir_nova_aba ? 'noopener noreferrer' : undefined}
                class="footer-nav-link"
              >
                {item.titulo}
              </a>
              <!-- Se tiver filhos (dropdown), mostra também -->
              {item.filhos.length > 0 && (
                <ul class="footer-nav-sub">
                  {item.filhos.map((filho: MenuItem) => (
                    <li>
                      <a
                        href={filho.link}
                        target={filho.abrir_nova_aba ? '_blank' : '_self'}
                        rel={filho.abrir_nova_aba ? 'noopener noreferrer' : undefined}
                        class="footer-nav-link footer-nav-link--sub"
                      >
                        {filho.titulo}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Secção de redes sociais -->
    <div class="footer-social">
      <h4 class="social-title">Redes Sociais</h4>
      <div class="social-links">
        {SITE_CONFIG.redesSociais.facebook && (
          <a href={SITE_CONFIG.redesSociais.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        )}
        {SITE_CONFIG.redesSociais.instagram && (
          <a href={SITE_CONFIG.redesSociais.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        )}
        {SITE_CONFIG.redesSociais.website && (
          <a href={SITE_CONFIG.redesSociais.website} target="_blank" rel="noopener noreferrer" aria-label="Website Oficial" class="social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
        )}
      </div>
    </div>

  </div>

  <!-- Barra inferior com direitos de autor e links legais -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p>&copy; {SITE_CONFIG.ano} {SITE_CONFIG.nome}. Todos os direitos reservados.</p>
      <div class="footer-bottom-links">
        {SITE_CONFIG.linksLegais.livroReclamacoes && (
          <a href={SITE_CONFIG.linksLegais.livroReclamacoes} target="_blank" rel="noopener noreferrer" class="livro-reclamacoes">
            Livro de Reclamações
          </a>
        )}
      </div>
    </div>
  </div>
</footer>