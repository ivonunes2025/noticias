---
// AudioReader.astro
// Botão para leitura de texto (Acessibilidade)
---

<div class="audio-reader-container">
  <button id="tts-toggle" class="tts-btn" title="Ouvir Notícia">
    <span class="tts-icon-play">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
    </span>
    <span class="tts-icon-stop" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6" y="6" width="12" height="12"></rect>
      </svg>
    </span>
    <span id="tts-text">Ouvir Notícia</span>
  </button>
</div>

<style>
  .audio-reader-container {
    display: inline-block;
    margin-right: 12px;
  }

  .tts-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(200, 150, 62, 0.1);
    color: var(--cor-destaque);
    border: 1px solid var(--cor-destaque);
    padding: 8px 16px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tts-btn:hover {
    background: var(--cor-destaque);
    color: var(--cor-fundo);
  }

  .tts-btn.is-playing {
    background: #ef4444;
    border-color: #ef4444;
    color: white;
  }
</style>

<script>
  function setupTTS() {
    const btn = document.getElementById('tts-toggle');
    const textSpan = document.getElementById('tts-text');
    const playIcon = document.querySelector('.tts-icon-play') as HTMLElement;
    const stopIcon = document.querySelector('.tts-icon-stop') as HTMLElement;
    
    if (!btn || !textSpan || !playIcon || !stopIcon) return;

    let isPlaying = false;

    const stopReading = () => {
      window.speechSynthesis.cancel();
      isPlaying = false;
      btn.classList.remove('is-playing');
      playIcon.style.display = 'block';
      stopIcon.style.display = 'none';
      textSpan.textContent = 'Ouvir Notícia';
    };

    const startReading = () => {
      // 1. Capturar o título e o conteúdo da notícia
      const titulo = document.querySelector('h1')?.textContent || '';
      const conteudo = document.querySelector('.detalhe-texto')?.textContent || '';
      const fullText = `${titulo}. ${conteudo}`;

      if (!fullText.trim()) return;

      // 2. Configurar a síntese de voz
      const utterance = new SpeechSynthesisUtterance(fullText);
      utterance.lang = 'pt-PT';
      utterance.rate = 1.0; // Velocidade normal

      utterance.onend = stopReading;
      utterance.onerror = stopReading;

      window.speechSynthesis.speak(utterance);
      
      isPlaying = true;
      btn.classList.add('is-playing');
      playIcon.style.display = 'none';
      stopIcon.style.display = 'block';
      textSpan.textContent = 'Parar Leitura';
    };

    btn.addEventListener('click', () => {
      if (isPlaying) {
        stopReading();
      } else {
        startReading();
      }
    });

    // Parar leitura se o utilizador sair da página
    window.addEventListener('beforeunload', () => {
      window.speechSynthesis.cancel();
    });
  }

  // Inicializa
  setupTTS();
  // Reinicializa após navegação do Astro
  document.addEventListener('astro:after-swap', setupTTS);
</script>
