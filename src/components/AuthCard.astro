---
/**
 * Componente AuthCard
 * Contentor padronizado para as páginas de autenticação.
 */
import "../styles/auth-card.css";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="auth-card reveal">
  <div class="auth-header">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
  <slot />
</div>
