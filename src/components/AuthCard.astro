---
/**
 * Componente AuthCard
 * Contentor padronizado para as páginas de autenticação.
 */
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="auth-card reveal">
  <div class="auth-header">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
  <slot />
</div>

<style>
  .auth-card {
    background: var(--cor-fundo-card);
    border: 1px solid var(--cor-borda);
    border-radius: 24px;
    padding: 48px;
    width: 100%;
    max-width: 480px;
    box-shadow: var(--sombra);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .auth-header h1 {
    font-family: var(--fonte-titulo);
    font-size: 2.2rem;
    color: var(--cor-principal);
    margin-bottom: 8px;
  }

  .auth-header p {
    color: var(--cor-texto-suave);
    font-size: 1rem;
    margin: 0 auto;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 32px 24px;
      border-radius: 0;
      border: none;
      background: transparent;
      box-shadow: none;
    }
  }
</style>
