---
// Componente ShareMenu: Um menu de partilha para notícias.
// Permite partilhar no Facebook, Twitter, WhatsApp e copiar o link.

// Importa os estilos CSS associados a este componente.
import "../styles/share-menu.css";
---

<!-- O contêiner principal que posiciona o menu dropdown. -->
<div class="share-container">
  <!-- O botão que abre e fecha o menu de partilha. -->
  <button id="share-toggle" class="share-toggle-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span>Partilhar</span>
  </button>

  <!-- O menu dropdown que contém as opções de partilha, escondido por defeito. -->
  <div id="share-dropdown" class="share-dropdown">
    <!-- Opção de partilha no Facebook. -->
    <a id="share-facebook" href="#" target="_blank" rel="noopener noreferrer" class="share-option">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      <span>Facebook</span>
    </a>
    <!-- Opção de partilha no Twitter. -->
    <a id="share-twitter" href="#" target="_blank" rel="noopener noreferrer" class="share-option">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
      <span>Twitter</span>
    </a>
    <!-- Opção de partilha no WhatsApp. -->
    <a id="share-whatsapp" href="#" target="_blank" rel="noopener noreferrer" class="share-option">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      <span>WhatsApp</span>
    </a>
    <!-- Botão para copiar o link da página. -->
    <button id="copy-link" class="share-option">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.72"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.72"></path></svg>
      <span id="copy-link-text">Copiar Link</span>
    </button>
  </div>
</div>

<script>
  // Função que configura a lógica do menu de partilha.
  function setupShareMenu() {
    const toggleBtn = document.getElementById('share-toggle');
    const dropdown = document.getElementById('share-dropdown');
    const copyBtn = document.getElementById('copy-link');
    const copyText = document.getElementById('copy-link-text');

    // Se os elementos essenciais não existirem, a função termina.
    if (!toggleBtn || !dropdown || !copyBtn || !copyText) return;

    // Obtém a URL e o título da página atual para usar nos links de partilha.
    const url = window.location.href;
    const title = document.title;

    // Define os links de partilha para cada rede social.
    (document.getElementById('share-facebook') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
    (document.getElementById('share-twitter') as HTMLAnchorElement).href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
    (document.getElementById('share-whatsapp') as HTMLAnchorElement).href = `https://api.whatsapp.com/send?text=${encodeURIComponent(title + " " + url)}`;

    // Adiciona o evento de clique ao botão principal para abrir/fechar o dropdown.
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Impede que o clique feche o menu imediatamente.
      dropdown.classList.toggle('active');
    });

    // Adiciona o evento de clique ao botão de copiar link.
    copyBtn.addEventListener('click', () => {
      // Usa a API do Clipboard para copiar a URL para a área de transferência.
      navigator.clipboard.writeText(url).then(() => {
        // Atualiza o texto do botão para dar feedback ao utilizador.
        copyText.textContent = 'Copiado!';
        // Repõe o texto original após 2 segundos.
        setTimeout(() => {
          copyText.textContent = 'Copiar Link';
        }, 2000);
      });
    });

    // Adiciona um evento para fechar o dropdown se o utilizador clicar em qualquer outro lugar da página.
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
        dropdown.classList.remove('active');
      }
    });
  }

  // Executa a configuração quando o DOM está pronto.
  setupShareMenu();
  // Executa novamente após uma transição de página no Astro.
  document.addEventListener('astro:after-swap', setupShareMenu);
</script>
