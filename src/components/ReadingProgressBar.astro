---
// ReadingProgressBar.astro
// Barra de progresso de leitura fixa no topo
import "../styles/reading-progress-bar.css";
---

<div class="reading-progress-container">
  <div id="reading-progress-bar" class="reading-progress-bar"></div>
</div>

<script>
  function setupReadingProgress() {
    const progressBar = document.getElementById('reading-progress-bar');
    if (!progressBar) return;

    const updateProgress = () => {
      // Altura total do documento menos a altura da janela visual
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      
      if (totalHeight <= 0) {
        progressBar.style.width = '0%';
        return;
      }

      // Quanto o utilizador já fez scroll
      const progress = (window.scrollY / totalHeight) * 100;
      
      // Limita entre 0 e 100
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    };

    window.addEventListener('scroll', updateProgress);
    // Atualiza inicialmente
    updateProgress();
  }

  // Inicializa
  setupReadingProgress();
  // Reinicializa após navegação do Astro
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
