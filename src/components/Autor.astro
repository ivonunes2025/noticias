---
import { getImageUrl, normalize } from "../utils/strapi";
import "../styles/autor.css";

interface Props {
  autor: {
    nome: string;
    foto?: any;
    slug?: string;
    id?: number | string;
  };
  variant?: "small" | "large";
  showBorder?: boolean;
}

const { autor: rawAutor, variant = "small", showBorder = true } = Astro.props;

if (!rawAutor) return null;

// Normaliza o objeto do autor
const autor = normalize(rawAutor);
const fotoUrl = getImageUrl(autor.foto);

// Usa o slug para o link
const autorLink = autor.slug ? `/autores/${autor.slug}` : null;
---

<div class={`autor-info autor-info--${variant} ${showBorder ? 'has-border' : ''}`}>
  {autorLink ? (
    <a href={autorLink} class="autor-foto-wrapper">
      {fotoUrl ? (
        <img 
          src={fotoUrl} 
          alt={autor.nome} 
          class="autor-foto-img"
          loading="lazy"
        />
      ) : (
        <div class="autor-foto-placeholder">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
      )}
    </a>
  ) : (
    <div class="autor-foto-wrapper">
      {fotoUrl ? (
        <img 
          src={fotoUrl} 
          alt={autor.nome} 
          class="autor-foto-img"
          loading="lazy"
        />
      ) : (
        <div class="autor-foto-placeholder">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
      )}
    </div>
  )}

  <div class="autor-detalhes">
    {autorLink ? (
      <a href={autorLink} class="autor-nome autor-link">{autor.nome}</a>
    ) : (
      <span class="autor-nome">{autor.nome}</span>
    )}
    {variant === "large" && autor.cargo && (
      <span class="autor-cargo">{autor.cargo}</span>
    )}
  </div>
</div>