---
import { getImageUrl } from "../utils/strapi";
import "../styles/homepage-banner.css";

const STRAPI = import.meta.env.STRAPI_URL?.replace(/\/$/, '');

interface BannerSlide {
  url: string;
  link: string | null;
  alt: string;
  titulo: string | null;
  subtitulo: string | null;
  btnTexto: string | null;
  btnLink: string | null;
}

let slides: BannerSlide[] = [];

try {
  const url = `${STRAPI}/api/homepage-banners?populate=*&pagination[pageSize]=1&sort=createdAt:desc`;
  const res = await fetch(url);

  if (res.ok) {
    const json = await res.json();
    const raw = json.data?.[0];

    if (raw) {
      const data = raw?.attributes ?? raw;

      if (data.ativo !== false) {
        const imagens = [
          { n: 1, media: data.imagem_1 },
          { n: 2, media: data.imagem_2 },
          { n: 3, media: data.imagem_3 },
        ];

        for (const { n, media } of imagens) {
          const imgUrl = getImageUrl(media);
          if (!imgUrl) continue;

          const alt =
            media?.alternativeText ??
            media?.attributes?.alternativeText ??
            media?.data?.attributes?.alternativeText ??
            `Banner ${n}`;

          slides.push({
            url:       imgUrl,
            alt,
            link:      (data[`link_${n}`]      as string) || null,
            titulo:    (data[`titulo_${n}`]    as string) || null,
            subtitulo: (data[`subtitulo_${n}`] as string) || null,
            btnTexto:  (data[`bnt_texto_${n}`] as string)
                    || (data[`btn_texto_${n}`] as string)
                    || null,
            btnLink:   (data[`btn_link_${n}`]  as string)
                    || (data[`link_${n}`]       as string)
                    || null,
          });
        }
      }
    }
  }
} catch (e) {
  console.warn("[HomepageBanner] Erro:", e);
}

const hasMultiple = slides.length > 1;
const hasBanner   = slides.length > 0;
---

{hasBanner && (
  <div class="banner-outer">
    <div
      id="homepage-banner"
      class={`banner-wrapper ${hasMultiple ? "banner--slideshow" : "banner--single"}`}
      aria-label="Banner principal"
      role="region"
    >
      <div class="banner-track" id="banner-track">
        {slides.map((slide, i) => (
          <div
            class={`banner-slide ${i === 0 ? "is-active" : ""}`}
            data-index={i}
            aria-hidden={i !== 0}
          >
            <!-- Imagem -->
            {slide.link ? (
              <a href={slide.link} class="banner-link" tabindex={i === 0 ? 0 : -1}>
                <img src={slide.url} alt={slide.alt} class="banner-img"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"} />
              </a>
            ) : (
              <img src={slide.url} alt={slide.alt} class="banner-img"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"} />
            )}

            <!-- Overlay: aparece sempre que titulo OU botão existam -->
            {(slide.titulo || slide.btnTexto) && (
              <div class="banner-content">
                {slide.titulo    && <h2 class="banner-titulo">{slide.titulo}</h2>}
                {slide.subtitulo && <p  class="banner-subtitulo">{slide.subtitulo}</p>}
                {(slide.btnTexto && slide.btnLink) && (
                  <a href={slide.btnLink} class="banner-btn" tabindex={i === 0 ? 0 : -1}>
                    {slide.btnTexto}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        ))}
      </div>

      {hasMultiple && (
        <>
          <button class="banner-arrow banner-arrow--prev" id="banner-prev" aria-label="Slide anterior" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button class="banner-arrow banner-arrow--next" id="banner-next" aria-label="Próximo slide" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
          <div class="banner-dots" role="tablist" aria-label="Selecionar slide">
            {slides.map((_, i) => (
              <button class={`banner-dot ${i === 0 ? "is-active" : ""}`} data-dot={i}
                role="tab" aria-label={`Slide ${i + 1}`} aria-selected={i === 0} type="button" />
            ))}
          </div>
        </>
      )}
    </div>
  </div>
)}

<script>
  function initBanner() {
    console.log("[HomepageBanner] initBanner called");
    const wrapper = document.getElementById("homepage-banner");
    if (!wrapper) {
      console.log("[HomepageBanner] No wrapper found");
      return;
    }

    const slides = Array.from(wrapper.querySelectorAll<HTMLElement>(".banner-slide"));
    console.log("[HomepageBanner] Found slides count:", slides.length);
    if (slides.length <= 1) return;

    const dots    = Array.from(wrapper.querySelectorAll<HTMLElement>(".banner-dot"));
    const prevBtn = document.getElementById("banner-prev");
    const nextBtn = document.getElementById("banner-next");

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      console.log("[HomepageBanner] goTo index:", index, "current:", current);
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      dots[current]?.classList.remove("is-active");
      dots[current]?.setAttribute("aria-selected", "false");
      slides[current].querySelectorAll<HTMLAnchorElement>("a").forEach(a => a.setAttribute("tabindex", "-1"));

      current = (index + slides.length) % slides.length;

      slides[current].classList.add("is-active");
      slides[current].setAttribute("aria-hidden", "false");
      dots[current]?.classList.add("is-active");
      dots[current]?.setAttribute("aria-selected", "true");
      slides[current].querySelectorAll<HTMLAnchorElement>("a").forEach(a => a.setAttribute("tabindex", "0"));
    }

    const start = () => { 
      console.log("[HomepageBanner] Starting interval...");
      stop(); 
      timer = setInterval(() => {
        console.log("[HomepageBanner] Interval tick, going to next slide:", current + 1);
        goTo(current + 1);
      }, 10000); 
    };
    const stop  = () => { 
      if (timer) { 
        console.log("[HomepageBanner] Stopping interval...");
        clearInterval(timer); 
        timer = null; 
      } 
    };

    prevBtn?.addEventListener("click", () => { goTo(current - 1); start(); });
    nextBtn?.addEventListener("click", () => { goTo(current + 1); start(); });
    dots.forEach((d, i) => d.addEventListener("click", () => { goTo(i); start(); }));

    wrapper.addEventListener("mouseenter", stop);
    wrapper.addEventListener("mouseleave", start);

    let tx = 0;
    wrapper.addEventListener("touchstart", (e) => { tx = e.changedTouches[0].screenX; }, { passive: true });
    wrapper.addEventListener("touchend",   (e) => {
      const d = tx - e.changedTouches[0].screenX;
      if (Math.abs(d) > 50) { goTo(d > 0 ? current + 1 : current - 1); start(); }
    }, { passive: true });

    wrapper.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft")  { goTo(current - 1); start(); }
      if (e.key === "ArrowRight") { goTo(current + 1); start(); }
    });

    document.addEventListener("visibilitychange", () => document.hidden ? stop() : start());

    start();
  }

  initBanner();
  document.addEventListener("astro:after-swap", initBanner);
</script>