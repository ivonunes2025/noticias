---
// Componente PrivateOverlay: Uma sobreposição visual para indicar conteúdo privado.
// Pode ser usado em duas variantes: "card" (um ícone pequeno) ou "full" (uma sobreposição completa).

// Importa os estilos CSS associados a este componente.
import "../styles/private-overlay.css";

// Define as propriedades que o componente pode receber.
interface Props {
  variant?: 'card' | 'full'; // O tipo de sobreposição a ser exibido.
}

// Extrai a propriedade `variant`, com `card` como valor padrão.
const { variant = 'card' } = Astro.props;
---

<!-- 
  O contêiner principal da sobreposição.
  A classe `full` ou `card` é aplicada com base na variante para estilização.
-->
<div class={`private-overlay ${variant}`}>
  <!-- Se a variante for "card", mostra um ícone de cadeado e um pequeno texto. -->
  {variant === 'card' && (
    <>
      <div class="lock-icon-container">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <span class="private-badge">Exclusivo</span>
    </>
  )}

  <!-- Se a variante for "full", mostra uma mensagem completa com título, texto e botões. -->
  {variant === 'full' && (
    <div class="private-content-info">
      <div class="lock-icon-container">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2>Conteúdo Exclusivo</h2>
      <p>Esta notícia é exclusiva para membros. Faça login ou registe-se para ler o artigo completo.</p>
      <div class="private-actions">
        <a href="/login" class="btn btn--secondary">Entrar</a>
        <a href="/registo" class="btn btn--primary">Criar Conta</a>
      </div>
    </div>
  )}
</div>
