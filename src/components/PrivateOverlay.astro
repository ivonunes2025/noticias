---
// PrivateOverlay.astro
// Componente centralizado para exibir o bloqueio de conteúdo privado
import "../styles/private-overlay.css";

interface Props {
  variant?: 'card' | 'full'; // 'card' para listas, 'full' para detalhe da notícia
}

const { variant = 'card' } = Astro.props;
---

<div class={`private-overlay ${variant}`}>
  <div class="lock-icon-container">
    <svg xmlns="http://www.w3.org/2000/svg" width={variant === 'full' ? 48 : 32} height={variant === 'full' ? 48 : 32} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
      <line x1="1" y1="1" x2="23" y2="23"></line>
    </svg>
  </div>
  
  {variant === 'card' ? (
    <div class="private-badge">Ler mais</div>
  ) : (
    <div class="private-content-info">
      <h2>Conteúdo Privado</h2>
      <p>Esta notícia é exclusiva para membros registados.</p>
    </div>
  )}
</div>
