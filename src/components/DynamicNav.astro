---
// src/components/DynamicNav.astro

import { getMenu } from '../utils/menus';
import { fetchStrapi, normalize } from '../utils/strapi';
import type { MenuItem } from '../utils/menus';

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;

const STRAPI = import.meta.env.STRAPI_URL?.replace(/\/$/, '');

// ── Busca categorias directamente (sem depender do fetchStrapi wrapper) ──
// Testa os dois endpoints possíveis: /categoria e /categorias
let categorias: any[] = [];

try {
  // Tenta primeiro /categorias (plural)
  const res1 = await fetch(`${STRAPI}/api/categorias?pagination[pageSize]=100`);
  if (res1.ok) {
    const json1 = await res1.json();
    const arr = json1?.data ?? [];
    // Normaliza v4 ({ id, attributes }) e v5 ({ id, nome, slug })
    categorias = arr.map((c: any) => ({
      id: c.id,
      nome: c?.attributes?.nome ?? c.nome ?? c?.attributes?.name ?? c.name ?? '',
      slug: c?.attributes?.slug ?? c.slug ?? '',
      ordem: c?.attributes?.ordem ?? c.ordem ?? null,
    })).filter((c: any) => c.slug);
  }

  // Se não encontrou nada, tenta /categoria (singular)
  if (categorias.length === 0) {
    const res2 = await fetch(`${STRAPI}/api/categoria?pagination[pageSize]=100`);
    if (res2.ok) {
      const json2 = await res2.json();
      const arr = json2?.data ?? [];
      categorias = arr.map((c: any) => ({
        id: c.id,
        nome: c?.attributes?.nome ?? c.nome ?? c?.attributes?.name ?? c.name ?? '',
        slug: c?.attributes?.slug ?? c.slug ?? '',
        ordem: c?.attributes?.ordem ?? c.ordem ?? null,
      })).filter((c: any) => c.slug);
    }
  }

  // Ordena as categorias no Javascript: as que têm ordem vão primeiro, as sem ordem (null) vão para o fim (999)
  categorias.sort((a, b) => {
    const aOrdem = (a.ordem !== null && a.ordem !== undefined) ? Number(a.ordem) : 999;
    const bOrdem = (b.ordem !== null && b.ordem !== undefined) ? Number(b.ordem) : 999;
    if (aOrdem !== bOrdem) return aOrdem - bOrdem;
    return a.nome.localeCompare(b.nome);
  });
} catch (e) {
  console.error('[DynamicNav] Erro ao buscar categorias:', e);
}

// Busca o menu configurado no Strapi
const menu = await getMenu(slug);

// Regra de auto-injeção: item com link /categorias e sem filhos manuais
function shouldInjectCategorias(item: MenuItem): boolean {
  return (
    item.link.startsWith('/categorias') &&
    item.filhos.length === 0 &&
    categorias.length > 0
  );
}

function buildItens(itens: MenuItem[]): MenuItem[] {
  return itens.map(item => {
    if (shouldInjectCategorias(item)) {
      // 1. Mostrar as primeiras 4 categorias no dropdown
      const limit = 4;
      const dropdownCats = categorias.slice(0, limit).map((cat: any) => ({
        id: cat.id,
        titulo: cat.nome,
        link: `/categorias/${cat.slug}`,
        ordem: 0,
        abrir_nova_aba: false,
        filhos: [],
      }));

      // 2. Adicionar o item "Ver Mais" ao fim do dropdown
      dropdownCats.push({
        id: -9999,
        titulo: 'Ver Mais',
        link: '#subnavbar-toggle',
        ordem: 999,
        abrir_nova_aba: false,
        filhos: [],
      });

      return {
        ...item,
        filhos: dropdownCats,
      };
    }
    return item;
  });
}

const itensFinais = menu ? buildItens(menu.itens) : [];
---

{itensFinais.length > 0 && (
  <nav class={`dynamic-nav ${className ?? ''}`} aria-label={menu?.nome ?? 'Navegação'}>
    <ul class="dynamic-nav__list">
      {itensFinais.map((item: MenuItem) => (
        <li class={`dynamic-nav__item ${item.filhos.length > 0 ? 'has-dropdown' : ''}`}>
          {item.filhos.length > 0 ? (
            <>
              <button
                class="dynamic-nav__link dynamic-nav__link--parent"
                aria-haspopup="true"
                aria-expanded="false"
                data-dropdown-trigger
              >
                {item.titulo}
                <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>

              <ul class="dynamic-nav__dropdown" role="menu">
                <div class="dynamic-nav__dropdown-inner">
                  {item.filhos.map((filho: MenuItem) => (
                    <li role="none">
                      {filho.link === '#subnavbar-toggle' ? (
                        <>
                          {/* Categorias adicionais para expandir inline no mobile */}
                          <div class="mobile-remaining-cats" id="mobile-remaining-cats" style="display: none;">
                            {categorias.slice(4).map((cat: any) => (
                              <a
                                href={`/categorias/${cat.slug}`}
                                class="dynamic-nav__dropdown-item"
                                role="menuitem"
                              >
                                {cat.nome}
                              </a>
                            ))}
                          </div>

                          {/* Desktop: Abre a subnavbar */}
                          <button
                            class="dynamic-nav__dropdown-item subnavbar-trigger-btn desktop-only"
                            data-subnavbar-trigger
                            type="button"
                          >
                            {filho.titulo}
                          </button>

                          {/* Mobile: Mostra as categorias restantes inline no accordion */}
                          <button
                            class="dynamic-nav__dropdown-item subnavbar-trigger-btn mobile-only"
                            id="mobile-ver-mais-btn"
                            type="button"
                          >
                            {filho.titulo}
                          </button>
                        </>
                      ) : (
                        <a
                          href={filho.link}
                          class="dynamic-nav__dropdown-item"
                          target={filho.abrir_nova_aba ? '_blank' : '_self'}
                          role="menuitem"
                        >
                          {filho.titulo}
                        </a>
                      )}
                    </li>
                  ))}
                </div>
              </ul>
            </>
          ) : (
            <a
              href={item.link}
              class="dynamic-nav__link"
              target={item.abrir_nova_aba ? '_blank' : '_self'}
            >
              {item.titulo}
            </a>
          )}
        </li>
      ))}
    </ul>

    {/* Subnavbar Flutuante de Categorias (Desktop) */}
    <div class="dynamic-nav__subnavbar" id="categories-subnavbar">
      <div class="dynamic-nav__subnavbar-inner">
        {categorias.map((cat: any) => (
          <a href={`/categorias/${cat.slug}`} class="subnavbar-item">
            {cat.nome}
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<style>
  .dynamic-nav__list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dynamic-nav__item {
    position: relative;
  }

  .dynamic-nav__link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--fonte-corpo);
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .dynamic-nav__link:hover,
  .has-dropdown:hover .dynamic-nav__link--parent,
  .dynamic-nav__link--parent[aria-expanded="true"] {
    color: var(--cor-principal);
    background: var(--cor-destaque-claro);
  }

  .dropdown-chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .has-dropdown:hover .dropdown-chevron,
  .dynamic-nav__link--parent[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dynamic-nav__dropdown {
    position: absolute;
    top: 100%; /* Removido o gap de 8px para evitar fechar ao mover o rato */
    left: 0;
    padding-top: 8px; /* Adicionado padding para manter o aspecto visual mas sem gap real */
    min-width: 220px;
    max-height: 400px;
    overflow-y: auto;
    background: transparent; /* Fundo transparente no container principal */
    border: none;
    border-radius: 12px;
    list-style: none;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 200;
  }

  /* Container interno com o fundo real */
  .dynamic-nav__dropdown-inner {
    background: rgba(18, 18, 18, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.15) transparent;
  }

  .dynamic-nav__dropdown-inner::-webkit-scrollbar { width: 4px; }
  .dynamic-nav__dropdown-inner::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.15);
    border-radius: 4px;
  }

  .has-dropdown:hover .dynamic-nav__dropdown,
  .dynamic-nav__item:focus-within .dynamic-nav__dropdown {
    opacity: 1;
    pointer-events: all;
    transform: translateY(0);
  }

  .dynamic-nav__link--parent[aria-expanded="true"] ~ .dynamic-nav__dropdown {
    opacity: 1;
    pointer-events: all;
    transform: translateY(0);
  }

  .dynamic-nav__dropdown.oculto {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(-6px) !important;
  }

  .dynamic-nav__dropdown-item {
    display: block;
    padding: 9px 14px;
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .dynamic-nav__dropdown-item:hover {
    color: var(--cor-principal);
    background: rgba(255, 255, 255, 0.07);
  }

  .dynamic-nav__dropdown-item--header {
    color: var(--cor-destaque);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dynamic-nav__dropdown-item--header:hover {
    color: var(--cor-destaque);
    background: var(--cor-destaque-claro);
  }

  .dynamic-nav__divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    margin: 4px 8px;
  }

  /* ── Responsive Utils ── */
  .desktop-only {
    display: block;
  }
  .mobile-only {
    display: none;
  }

  /* ── Subnavbar de Categorias ── */
  .dynamic-nav__subnavbar {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(15, 15, 15, 0.99);
    border-bottom: 2px solid var(--cor-destaque, #c8963e);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, padding 0.35s ease;
    z-index: 90;
    padding: 0 24px;
  }

  .dynamic-nav__subnavbar.aberto {
    max-height: 300px; /* Permite múltiplas linhas se houver muitas categorias */
    opacity: 1;
    padding: 20px 24px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  .subnavbar-trigger-btn {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    color: var(--cor-destaque, #c8963e) !important;
    font-weight: 700 !important;
    padding: 9px 14px;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .subnavbar-trigger-btn:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .dynamic-nav__subnavbar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap; /* Permite quebrar em múltiplas linhas */
    gap: 12px 24px; /* Espaço vertical de 12px e horizontal de 24px */
  }

  .subnavbar-item {
    font-family: var(--fonte-corpo);
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.2s ease;
    text-transform: capitalize;
  }

  .subnavbar-item:hover {
    color: var(--cor-destaque);
    transform: translateY(-1px);
  }

  /* ── Mobile ── */
  .dynamic-nav--mobile .dynamic-nav__list {
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
  }

  .dynamic-nav--mobile .dynamic-nav__link {
    padding: 10px 12px;
    font-size: 0.92rem;
    width: 100%;
    justify-content: space-between;
  }

  .dynamic-nav--mobile .dynamic-nav__dropdown {
    position: static;
    opacity: 1;
    pointer-events: all;
    transform: none;
    box-shadow: none;
    border: none;
    background: transparent;
    padding-left: 12px;
    border-left: 2px solid rgba(200, 150, 62, 0.3);
    margin-left: 12px;
    margin-bottom: 4px;
    max-height: none;
    display: none;
  }

  .dynamic-nav--mobile .dynamic-nav__dropdown.mobile-open {
    display: block;
  }

  .dynamic-nav--mobile .dynamic-nav__dropdown-item {
    white-space: normal;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }
    .mobile-only {
      display: block !important;
    }
    .dynamic-nav__subnavbar {
      display: none !important;
    }
  }
</style>

<script>
  function setupDynamicNav() {
    const closeAllDropdowns = () => {
      document.querySelectorAll('[data-dropdown-trigger][aria-expanded="true"]')
        .forEach(btn => btn.setAttribute('aria-expanded', 'false'));
    };

    const closeSubnavbar = () => {
      const subnavbar = document.getElementById('categories-subnavbar');
      subnavbar?.classList.remove('aberto');
    };

    document.querySelectorAll('[data-dropdown-trigger]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAllDropdowns();
        closeSubnavbar(); // Fecha a subnavbar se abrir outro dropdown
        if (!isOpen) btn.setAttribute('aria-expanded', 'true');
      });
    });

    // Subnavbar toggle logic via the button inside the dropdown (Desktop)
    const subnavbarTrigger = document.querySelector('[data-subnavbar-trigger]');
    const subnavbar = document.getElementById('categories-subnavbar');

    subnavbarTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      
      // Ocultar o dropdown pai temporariamente para não sobrepor a subnavbar
      const dropdown = subnavbarTrigger.closest('.dynamic-nav__dropdown');
      dropdown?.classList.add('oculto');

      closeAllDropdowns(); // Fecha o dropdown pai ao clicar em "Ver Mais"

      const isOpen = subnavbar?.classList.contains('aberto');
      if (isOpen) {
        subnavbar?.classList.remove('aberto');
      } else {
        subnavbar?.classList.add('aberto');
      }
    });

    // Quando o rato sai do item de menu com dropdown, removemos o estado oculto
    document.querySelectorAll('.has-dropdown').forEach(li => {
      li.addEventListener('mouseleave', () => {
        const dropdown = li.querySelector('.dynamic-nav__dropdown');
        dropdown?.classList.remove('oculto');
      });
    });

    document.addEventListener('click', (e) => {
      closeAllDropdowns();
      
      // Fecha a subnavbar se clicar fora dela
      if (subnavbar && !subnavbar.contains(e.target as Node) && e.target !== subnavbarTrigger) {
        closeSubnavbar();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        closeSubnavbar();
      }
    });

    // Mobile: expandir/colapsar menu normal
    document.querySelectorAll('.dynamic-nav--mobile [data-dropdown-trigger]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const li = btn.closest('.dynamic-nav__item');
        const dropdown = li?.querySelector('.dynamic-nav__dropdown');
        if (!dropdown) return;
        const isOpen = dropdown.classList.contains('mobile-open');
        document.querySelectorAll('.dynamic-nav--mobile .dynamic-nav__dropdown.mobile-open')
          .forEach(d => d.classList.remove('mobile-open'));
        if (!isOpen) dropdown.classList.add('mobile-open');
      });
    });

    // Mobile: mostrar categorias restantes dentro do accordion
    const mobileVerMaisBtn = document.getElementById('mobile-ver-mais-btn');
    const mobileRemainingCats = document.getElementById('mobile-remaining-cats');
    mobileVerMaisBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (mobileRemainingCats) {
        mobileRemainingCats.style.display = 'block';
        mobileVerMaisBtn.style.display = 'none';
      }
    });
  }

  setupDynamicNav();
  document.addEventListener('astro:after-swap', setupDynamicNav);
</script>