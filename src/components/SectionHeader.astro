---
// Componente SectionHeader: Um cabeçalho padronizado para as secções do site.
// Cria um título <h2> com uma linha decorativa e um link opcional "Ver mais".

// Importa os estilos CSS associados a este componente.
import "../styles/section-header.css";

// Define as propriedades que o componente pode receber.
interface Props {
  title: string;    // O texto do título.
  link?: string;   // A URL para o link "Ver mais" (opcional).
  href?: string;   // Alias para link.
  linkText?: string; // O texto para o link (padrão: "Ver mais").
}

// Extrai as propriedades, definindo um valor padrão para `linkText`.
const { title, link, href, linkText = "Ver mais" } = Astro.props;
const finalLink = link || href;
---

<!-- 
  O contêiner do cabeçalho da secção.
  Usa a tag <header> por razões semânticas.
-->
<header class="section-header">
  <!-- O título principal da secção. -->
  <h2>{title}</h2>
  <!-- O link "Ver mais" só é renderizado se a propriedade `link` for fornecida. -->
  {finalLink && (
    <a href={finalLink} class="ver-mais">{linkText}</a>
  )}
</header>
