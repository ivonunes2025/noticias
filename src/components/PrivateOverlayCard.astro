---
// Componente PrivateOverlayCard: Uma sobreposição visual pequena (ícone de cadeado) para indicar conteúdo privado em cartões.
// Importa os estilos CSS associados a este componente.
import "../styles/private-overlay.css";
---

<div class="private-overlay card">
  <div class="lock-icon-container">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </div>
  <span class="private-badge">Exclusivo</span>
</div>
