---
/**
 * Componente Button
 * Botão padronizado com variantes.
 */
interface Props {
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'outline' | 'danger';
  class?: string;
  id?: string;
  href?: string;
  [key: string]: any;
}

import "../styles/button.css";

const { 
  type = 'button', 
  variant = 'primary', 
  class: className = '', 
  id, 
  href,
  ...rest 
} = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element
  {...rest}
  id={id}
  href={href}
  type={href ? undefined : type}
  class:list={[
    'btn',
    `btn--${variant}`,
    className
  ]}
>
  <slot />
</Element>
