---
// Layout base do site:
// - injeta CSS global
// - define fontes/título/metadata
// - aplica a fonte escolhida nas Definições do Strapi
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { getDefinicoes, getFontUrl, getFontCssValue } from "../utils/definicoes";

// Headers de Cache
const userCookie = Astro.cookies.get('user_name')?.value;
const jwtCookie = Astro.cookies.get('jwt')?.value;

if (userCookie || jwtCookie) {
  Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, must-revalidate');
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=30');
}

// Busca definições globais (favicon, logo, fonte, etc)
const definicoes = await getDefinicoes();

// Fonte escolhida no Strapi
const fontUrl = getFontUrl(definicoes.fontFamily);
const fontCssValue = getFontCssValue(definicoes.fontFamily);

// Título da página
const { titulo = "Notícias Básicas", lcpImage } = Astro.props;

// Tema do cookie
const themeCookie = Astro.cookies.get('theme')?.value ?? 'default';
---

<!doctype html>
<html lang="pt" data-theme={themeCookie === 'default' ? undefined : themeCookie}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Pré-carregamento da imagem LCP se fornecida */}
    {lcpImage && (
      <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />
    )}

    {/* Script crítico para evitar flash de cor errada ao carregar */}
    <script is:inline>
      (function() {
        const getCookie = (name) => {
          const value = `; ${document.cookie}`;
          const parts = value.split(`; ${name}=`);
          if (parts.length === 2) return parts.pop().split(';').shift();
        };
        const theme = getCookie('theme') || localStorage.getItem('theme') || 'default';
        if (theme === 'default') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>

    {/* Favicon */}
    <link rel="icon" href={definicoes.favicon || "/favicon.ico"} />

    {/* Meta gerado automaticamente pelo Astro */}
    <meta name="generator" content={Astro.generator} />

    {/* Pré-conexões */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href={import.meta.env.STRAPI_URL} crossorigin />
    <link rel="dns-prefetch" href={import.meta.env.STRAPI_URL} />

    {/* 
      ── FONTE DINÂMICA (escolhida no Strapi) ──
      Carrega Inter, Open Sans ou Poppins conforme a definição.
      Usa display=swap para não bloquear o render.
    */}
    <link
      rel="preload"
      as="style"
      href={fontUrl}
    />
    <link
      href={fontUrl}
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href={fontUrl} rel="stylesheet" />
    </noscript>

    {/* Aplica a fonte como variável CSS global — sobrepõe o valor do global.css */}
    <style define:vars={{ fontCorpo: fontCssValue }}>
      :root {
        --fonte-corpo: var(--fontCorpo);
      }
      body {
        font-family: var(--fontCorpo);
      }
    </style>

    {/* Título da página */}
    <title>{titulo}</title>
  </head>
  <body>
    <slot />

    <CookieConsent />
    <Footer />

    <script>
      // Carregar lógica de carrossel apenas quando necessário
      function initCarousels() {
        document.querySelectorAll<HTMLElement>(".carrossel").forEach((carrossel) => {
          const track = carrossel.querySelector<HTMLElement>(".carrossel-track");
          const prevBtn = carrossel.querySelector<HTMLButtonElement>(".carrossel-prev");
          const nextBtn = carrossel.querySelector<HTMLButtonElement>(".carrossel-next");
          const slides = Array.from(carrossel.querySelectorAll<HTMLElement>(".carrossel-slide"));

          if (!track || !prevBtn || !nextBtn || slides.length === 0) return;

          const slideWidth = slides[0].offsetWidth + 24;

          prevBtn.addEventListener("click", () => {
            track.scrollBy({ left: -slideWidth, behavior: "smooth" });
          });

          nextBtn.addEventListener("click", () => {
            track.scrollBy({ left: slideWidth, behavior: "smooth" });
          });

          let isDown = false;
          let startX: number;
          let scrollLeft: number;

          track.addEventListener("mousedown", (e) => {
            isDown = true;
            track.classList.add("active");
            startX = e.pageX - track.offsetLeft;
            scrollLeft = track.scrollLeft;
          });

          track.addEventListener("mouseleave", () => {
            isDown = false;
            track.classList.remove("active");
          });

          track.addEventListener("mouseup", () => {
            isDown = false;
            track.classList.remove("active");
          });

          track.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - track.offsetLeft;
            const walk = (x - startX) * 2;
            track.scrollLeft = scrollLeft - walk;
          });
        });
      }

      if (document.readyState === 'complete') {
        initCarousels();
      } else {
        window.addEventListener('load', initCarousels);
      }

      // Registo do Service Worker para PWA / Offline
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('SW registered'))
            .catch(err => console.log('SW registration failed:', err));
        });
      }
    </script>
  </body>
</html>